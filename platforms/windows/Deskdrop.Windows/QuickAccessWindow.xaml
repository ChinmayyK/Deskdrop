<Window x:Class="Deskdrop.Windows.QuickAccessWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Quick Access" Height="600" Width="380"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        Deactivated="Window_Deactivated" Loaded="Window_Loaded">
    
    <Window.Resources>
        <SolidColorBrush x:Key="BrandElectric" Color="#0055CC"/>
        <SolidColorBrush x:Key="SurfaceElevated" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Ink" Color="#D9000000"/>
        <SolidColorBrush x:Key="InkSoft" Color="#8C000000"/>
        <SolidColorBrush x:Key="Stroke" Color="#1A000000"/>
        <SolidColorBrush x:Key="BrandRed" Color="#FF3B30"/>

        <!-- Hover Card Style -->
        <Style x:Key="HoverCardStyle" TargetType="Border">
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" Opacity="0.05" BlurRadius="4" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.02" Duration="0:0:0.15">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.02" Duration="0:0:0.15">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)" To="0.15" Duration="0:0:0.15"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.25">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.25">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)" To="0.05" Duration="0:0:0.25"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border CornerRadius="8" Background="#F2F2F7" BorderThickness="1" BorderBrush="#E5E5EA" Margin="16">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.2" BlurRadius="16" ShadowDepth="4"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <Border Grid.Row="0" Background="White" CornerRadius="12,12,0,0" Padding="16,12" BorderThickness="0,0,0,1" BorderBrush="#E5E5EA">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Hero Header (Mac Parity) -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Connection Dot -->
                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" Background="#1A00C853" Margin="0,0,12,0">
                            <iconPacks:PackIconLucide Kind="Link" Width="16" Height="16" Foreground="#00C853" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        
                        <!-- Status Text -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Deskdrop Active" FontSize="14" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
                            <TextBlock Text="Mesh Active" FontSize="11" FontWeight="Medium" Foreground="{StaticResource InkSoft}" Margin="0,2,0,0"/>
                        </StackPanel>
                        
                        <!-- Actions -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource ModernButton}" Width="28" Height="28" Background="#0D000000" Foreground="{StaticResource InkSoft}" Padding="0" Cursor="Hand" ToolTip="Diagnostics" Click="BtnHeaderDiagnostics_Click" AutomationProperties.Name="Open Diagnostics">
                                <iconPacks:PackIconLucide Kind="Info" Width="14" Height="14"/>
                            </Button>
                            <Button Style="{StaticResource ModernButton}" Width="28" Height="28" Background="#0D000000" Foreground="{StaticResource InkSoft}" Padding="0" Cursor="Hand" Margin="8,0,0,0" ToolTip="Quit" Click="BtnHeaderQuit_Click" AutomationProperties.Name="Quit Deskdrop">
                                <iconPacks:PackIconLucide Kind="Power" Width="14" Height="14"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                    
                    <TextBox x:Name="TxtSearch" Grid.Row="1" Margin="0,12,0,12" Padding="8,6" Background="#F2F2F7" BorderThickness="0" Foreground="{StaticResource Ink}" FontSize="13" TextChanged="TxtSearch_TextChanged">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TextBox">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <iconPacks:PackIconLucide Kind="Search" Width="14" Height="14" Foreground="{StaticResource InkSoft}" VerticalAlignment="Center" Margin="8,0,4,0"/>
                                                    <TextBlock Grid.Column="1" Text="Search clipboard..." Foreground="{StaticResource InkSoft}" Margin="0,0,0,0" VerticalAlignment="Center" Visibility="{Binding Text.IsEmpty, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    <ScrollViewer Grid.Column="1" x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    
                    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="DeviceTargetsList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource HoverCardStyle}" Background="#F2F2F7" BorderBrush="{StaticResource Stroke}" BorderThickness="0.5" CornerRadius="8" Padding="12,6" Margin="0,0,8,4" Cursor="Hand" Focusable="True" MouseLeftButtonDown="DeviceTarget_Click" KeyDown="Border_KeyDown" AutomationProperties.Name="Send to device">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconLucide Kind="Smartphone" Width="12" Height="12"    Foreground="{StaticResource BrandElectric}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding friendly_name}" FontSize="12" FontWeight="Medium" Foreground="{StaticResource Ink}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                <StackPanel>
                    <!-- JUST COPIED STRIP (Mac Parity) -->
                    <Border x:Name="QuickSendStrip" Margin="12,12,12,4" Background="{StaticResource BrandElectric}" CornerRadius="12" Padding="12" Cursor="Hand" Focusable="True" MouseLeftButtonDown="QuickSendStrip_Click" KeyDown="Border_KeyDown" AutomationProperties.Name="Send copied clipboard content">
                        <!-- We use EventTrigger for a breathing effect in code-behind or XAML if needed, but for now just styling -->
                        <Border.Effect>
                            <DropShadowEffect Color="#007AFF" Opacity="0.3" BlurRadius="12" ShadowDepth="4"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="#33FFFFFF" Margin="0,0,12,0">
                                <iconPacks:PackIconLucide Kind="ClipboardType" Width="16" Height="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="JUST COPIED" FontSize="10" FontWeight="Bold" Foreground="#B3FFFFFF" Margin="0,0,0,2"/>
                                <TextBlock Text="Waiting for clipboard..." x:Name="TxtQuickSendPreview" FontSize="13" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            
                            <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="12,6" VerticalAlignment="Center" Margin="8,0,0,0">
                                <TextBlock Text="Send" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrandElectric}"/>
                            </Border>
                        </Grid>
                    </Border>
                    
                    <ItemsControl x:Name="TimelineList" Padding="8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource HoverCardStyle}" CornerRadius="8" Background="{StaticResource SurfaceElevated}" BorderBrush="{StaticResource Stroke}" BorderThickness="0.5" Margin="4,4,4,8" Padding="12" Cursor="Hand" Focusable="True" MouseLeftButtonDown="HistoryItem_Click" KeyDown="Border_KeyDown" AutomationProperties.Name="Clipboard history item">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <Border Width="3" CornerRadius="1.5" Background="{StaticResource BrandElectric}" Margin="0,0,12,0"/>
                                    
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Summary}" Foreground="{StaticResource Ink}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Source}" Foreground="{StaticResource InkSoft}" FontSize="11" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding RelativeTime}" Foreground="{StaticResource InkSoft}" FontSize="10" FontWeight="Medium" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <Button   FontSize="12" Background="Transparent" Foreground="{Binding PinColor}" BorderThickness="0" Margin="0,0,4,0" Cursor="Hand" Click="BtnPinItem_Click" ToolTip="Pin to top"><iconPacks:PackIconLucide Kind="HelpCircle"/></Button>
                                        <Button   FontSize="12" Background="Transparent" Foreground="{StaticResource BrandRed}" BorderThickness="0" Cursor="Hand" Click="BtnDeleteItem_Click" ToolTip="Delete"><iconPacks:PackIconLucide Kind="Trash2"/></Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>

