<Window x:Class="Deskdrop.Windows.DropZoneWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Drop Files Here" Height="216" Width="320"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" WindowState="Normal" SizeToContent="Manual" ResizeMode="NoResize"
        AllowDrop="True" Drop="Window_Drop" DragEnter="Window_DragEnter" DragLeave="Window_DragLeave"
        MouseLeftButtonDown="Window_MouseLeftButtonDown" Loaded="Window_Loaded" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid Width="320" Height="216">
        <Border x:Name="DropGrid" HorizontalAlignment="Center" VerticalAlignment="Center" Width="320" Height="216" 
                Background="#CC1E1E24" CornerRadius="16" BorderBrush="#26FFFFFF" BorderThickness="1.5"
                Opacity="0.95" RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
            </Border.RenderTransform>
            
            <Border.Effect>
                <DropShadowEffect x:Name="WidgetShadow" Color="Black" Opacity="0.4" BlurRadius="24" ShadowDepth="12"/>
            </Border.Effect>
            
            <Border.Triggers>
                <EventTrigger RoutedEvent="DragEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1.0" Duration="0:0:0.15"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.03" Duration="0:0:0.25">
                                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.03" Duration="0:0:0.25">
                                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#0055CC" Duration="0:0:0.2"/>
                            <ThicknessAnimation Storyboard.TargetProperty="BorderThickness" To="2" Duration="0:0:0.2"/>
                            <ColorAnimation Storyboard.TargetName="WidgetShadow" Storyboard.TargetProperty="Color" To="#0055CC" Duration="0:0:0.2"/>
                            
                            <!-- Icon Circle Glow -->
                            <DoubleAnimation Storyboard.TargetName="IconGlow" Storyboard.TargetProperty="Opacity" To="0.5" Duration="0:0:0.2"/>
                            <ColorAnimation Storyboard.TargetName="IconBg" Storyboard.TargetProperty="(SolidColorBrush.Color)" To="#400055CC" Duration="0:0:0.2"/>
                            <DoubleAnimation Storyboard.TargetName="IconTranslate" Storyboard.TargetProperty="Y" To="4" Duration="0:0:0.2">
                                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="CircleRingScale" Storyboard.TargetProperty="ScaleX" To="1.12" Duration="0:0:0.25"/>
                            <DoubleAnimation Storyboard.TargetName="CircleRingScale" Storyboard.TargetProperty="ScaleY" To="1.12" Duration="0:0:0.25"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="DragLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.95" Duration="0:0:0.15"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.25">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.25">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#26FFFFFF" Duration="0:0:0.2"/>
                            <ThicknessAnimation Storyboard.TargetProperty="BorderThickness" To="1.5" Duration="0:0:0.2"/>
                            <ColorAnimation Storyboard.TargetName="WidgetShadow" Storyboard.TargetProperty="Color" To="Black" Duration="0:0:0.2"/>
                            
                            <!-- Icon Circle Revert -->
                            <DoubleAnimation Storyboard.TargetName="IconGlow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                            <ColorAnimation Storyboard.TargetName="IconBg" Storyboard.TargetProperty="(SolidColorBrush.Color)" To="#1AFFFFFF" Duration="0:0:0.2"/>
                            <DoubleAnimation Storyboard.TargetName="IconTranslate" Storyboard.TargetProperty="Y" To="-2" Duration="0:0:0.2">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="CircleRingScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.25"/>
                            <DoubleAnimation Storyboard.TargetName="CircleRingScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.25"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="Drop">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.9" Duration="0:0:0.1"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.9" Duration="0:0:0.1"/>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.0" Duration="0:0:0.1"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Border.Triggers>
            
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header Status Bar -->
                <Grid Grid.Row="0" Margin="16,14,16,0">
                    <!-- Status Pill -->
                    <Border HorizontalAlignment="Left" CornerRadius="12" Background="#991A1A1A" BorderBrush="#1AFFFFFF" BorderThickness="1" Padding="10,4">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusPillCircle" Width="6" Height="6" Fill="#34C759" Margin="0,0,6,0"/>
                            <TextBlock x:Name="StatusPillText" Text="Devices Ready" Foreground="#8CFFFFFF" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <!-- Close Button -->
                    <Button HorizontalAlignment="Right" Width="22" Height="22" Background="#801A1A1A" BorderBrush="#1AFFFFFF" BorderThickness="1" 
                            Foreground="#8CFFFFFF" Content="Ã—" FontSize="14" FontWeight="Bold" Cursor="Hand" Click="CloseButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- Drop Area Target -->
                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-4,0,0">
                    <Grid Width="58" Height="58" Margin="0,0,0,12" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="CircleRingScale" ScaleX="1.0" ScaleY="1.0"/>
                        </Grid.RenderTransform>
                        <Border CornerRadius="29" BorderBrush="#26FFFFFF" BorderThickness="1.5">
                            <Border.Background>
                                <SolidColorBrush x:Name="IconBg" Color="#1AFFFFFF"/>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect x:Name="IconGlow" Color="#0055CC" BlurRadius="12" ShadowDepth="0" Opacity="0"/>
                            </Border.Effect>
                        </Border>
                        
                        <iconPacks:PackIconLucide Kind="ArrowDownSquare" Width="24" Height="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <iconPacks:PackIconLucide.RenderTransform>
                                <TranslateTransform x:Name="IconTranslate" Y="-2"/>
                            </iconPacks:PackIconLucide.RenderTransform>
                        </iconPacks:PackIconLucide>
                    </Grid>
                    
                    <TextBlock x:Name="DropTitleText" Text="Drop to Broadcast" Foreground="White" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="DropSubText" Text="Wireless transfer to nearby devices" Foreground="#8CFFFFFF" FontSize="11.5" FontWeight="Medium" HorizontalAlignment="Center" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" MaxWidth="280"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
