<Window x:Class="Deskdrop.Windows.EdgeDropWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Deskdrop Edge Drop" Height="1080" Width="1"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" AllowDrop="True"
        DragEnter="Window_DragEnter" DragLeave="Window_DragLeave" Drop="Window_Drop"
        ResizeMode="NoResize">
    <Grid x:Name="MainGrid" Background="#01000000" ClipToBounds="True">
        <Border x:Name="PanelBorder" CornerRadius="16" Background="#E62A2A2A" HorizontalAlignment="Center" VerticalAlignment="Center" Width="150" Height="150" Opacity="0" RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform ScaleX="0.8" ScaleY="0.8" x:Name="PanelScale"/>
            </Border.RenderTransform>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="🚀" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock Text="Drop to Send" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center"/>
                <TextBlock Text="via Deskdrop" Foreground="#AAAAAA" FontSize="11" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
