<Window
    x:Class="Deskdrop.WinUI.IncomingFileBannerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Incoming File">

    <Grid Background="Transparent">
        <Border x:Name="AppTitleBar" Height="1" VerticalAlignment="Top" Background="Transparent" />
        
        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="28" BorderThickness="1.5" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Margin="12" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Icon -->
                <Grid Grid.Column="0" VerticalAlignment="Center">
                    <Ellipse Fill="#0A84FF" Width="44" Height="44" />
                    <FontIcon Glyph="&#xE8B7;" Foreground="White" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                
                <!-- File Info -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,16,0">
                    <TextBlock x:Name="TxtFileName" Text="Receiving File..." FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="TxtSenderName" Text="from Unknown" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13"/>
                </StackPanel>
                
                <!-- Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
                    <Button Width="44" Height="44" CornerRadius="22" Background="#34C759" Foreground="White" BorderThickness="0" Click="BtnAccept_Click" Padding="0">
                        <FontIcon Glyph="&#xE717;" FontSize="18"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
