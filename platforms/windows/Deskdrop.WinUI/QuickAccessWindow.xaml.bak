<Window x:Class="Deskdrop.Windows.QuickAccessWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Border CornerRadius="8" BorderThickness="1" BorderBrush="#E5E5EA" Margin="16">
<FrameworkElement.Resources>
        <SolidColorBrush x:Key="BrandElectric" Color="#0055CC"/>
        <SolidColorBrush x:Key="SurfaceElevated" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Ink" Color="#D9000000"/>
        <SolidColorBrush x:Key="InkSoft" Color="#8C000000"/>
        <SolidColorBrush x:Key="Stroke" Color="#1A000000"/>
        <SolidColorBrush x:Key="BrandRed" Color="#FF3B30"/>

        <!-- Hover Card Style -->
        <Style x:Key="HoverCardStyle" TargetType="Border">
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                </Setter.Value>
            </Setter>
            
            
        </Style>
    </FrameworkElement.Resources>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            
            <Border Grid.Row="0" CornerRadius="12,12,0,0" Padding="16,12" BorderThickness="0,0,0,1" BorderBrush="#E5E5EA">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    
                    <!-- Hero Header (Mac Parity) -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Connection Dot -->
                        <Border Grid.Column="0" CornerRadius="20" Margin="0,0,12,0">
                            <FontIcon Glyph="&#xE8A5;"  Foreground="#00C853" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        
                        <!-- Status Text -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Deskdrop Active" FontSize="14" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
                            <TextBlock Text="Mesh Active" FontSize="11" FontWeight="Medium" Foreground="{StaticResource InkSoft}" Margin="0,2,0,0"/>
                        </StackPanel>
                        
                        <!-- Actions -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource ModernButton}" Foreground="{StaticResource InkSoft}" Padding="0" Click="BtnHeaderDiagnostics_Click" AutomationProperties.Name="Open Diagnostics">
                                <FontIcon Glyph="&#xE8A5;" />
                            </Button>
                            <Button Style="{StaticResource ModernButton}" Foreground="{StaticResource InkSoft}" Padding="0"  Margin="8,0,0,0" Click="BtnHeaderQuit_Click" AutomationProperties.Name="Quit Deskdrop">
                                <FontIcon Glyph="&#xE8A5;" />
                            </Button>
                        </StackPanel>
                    </Grid>
                    
                    <TextBox x:Name="TxtSearch" Grid.Row="1" Margin="0,12,0,12" Padding="8,6" BorderThickness="0" Foreground="{StaticResource Ink}" FontSize="13" TextChanged="TxtSearch_TextChanged">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TextBox">
                                            <Border CornerRadius="6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition/>
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon Glyph="&#xE8A5;"  Foreground="{StaticResource InkSoft}" VerticalAlignment="Center" Margin="8,0,4,0"/>
                                                    <TextBlock Grid.Column="1" Text="Search clipboard..." Foreground="{StaticResource InkSoft}" Margin="0,0,0,0" VerticalAlignment="Center" Visibility="{Binding Text.IsEmpty, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    <ScrollViewer Grid.Column="1" x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    
                    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="DeviceTargetsList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource HoverCardStyle}" BorderBrush="{StaticResource Stroke}" BorderThickness="0.5" CornerRadius="8" Padding="12,6" Margin="0,0,8,4" KeyDown="Border_KeyDown" AutomationProperties.Name="Send to device">
                                        <StackPanel Orientation="Horizontal">
                                            <FontIcon Glyph="&#xE8A5;"     Foreground="{StaticResource BrandElectric}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding friendly_name}" FontSize="12" FontWeight="Medium" Foreground="{StaticResource Ink}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                <StackPanel>
                    <!-- JUST COPIED STRIP (Mac Parity) -->
                    <Border x:Name="QuickSendStrip" Margin="12,12,12,4" CornerRadius="12" Padding="12" KeyDown="Border_KeyDown" AutomationProperties.Name="Send copied clipboard content">
                        <!-- We use EventTrigger for a breathing effect in code-behind or XAML if needed, but for now just styling -->
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            
                            <Border Grid.Column="0" CornerRadius="18" Margin="0,0,12,0">
                                <FontIcon Glyph="&#xE8A5;"  Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="JUST COPIED" FontSize="10" FontWeight="Bold" Foreground="#B3FFFFFF" Margin="0,0,0,2"/>
                                <TextBlock Text="Waiting for clipboard..." x:Name="TxtQuickSendPreview" FontSize="13" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            
                            <Border Grid.Column="2" CornerRadius="8" Padding="12,6" VerticalAlignment="Center" Margin="8,0,0,0">
                                <TextBlock Text="Send" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrandElectric}"/>
                            </Border>
                        </Grid>
                    </Border>
                    
                    <ItemsControl x:Name="TimelineList" Padding="8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource HoverCardStyle}" CornerRadius="8" BorderBrush="{StaticResource Stroke}" BorderThickness="0.5" Margin="4,4,4,8" Padding="12" KeyDown="Border_KeyDown" AutomationProperties.Name="Clipboard history item">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <Border CornerRadius="1.5" Margin="0,0,12,0"/>
                                    
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Summary}" Foreground="{StaticResource Ink}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Source}" Foreground="{StaticResource InkSoft}" FontSize="11" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding RelativeTime}" Foreground="{StaticResource InkSoft}" FontSize="10" FontWeight="Medium" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <Button   FontSize="12" Foreground="{Binding PinColor}" BorderThickness="0" Margin="0,0,4,0"  Click="BtnPinItem_Click"><FontIcon Glyph="&#xE8A5;" /></Button>
                                        <Button   FontSize="12" Foreground="{StaticResource BrandRed}" BorderThickness="0"  Click="BtnDeleteItem_Click"><FontIcon Glyph="&#xE8A5;" /></Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>







