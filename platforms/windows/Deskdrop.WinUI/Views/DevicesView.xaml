<Page
    x:Class="Deskdrop.WinUI.Views.DevicesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Deskdrop.WinUI.Views"
    xmlns:winui="using:Deskdrop.WinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="Transparent">
        <Grid.ColumnDefinitions>
            <!-- Center Main Launchpad Content -->
            <ColumnDefinition Width="*"/>
            <!-- Right Device Inspector Panel -->
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <!-- CENTER LAUNCHPAD CONTENT -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="40,28,40,40">
            <StackPanel Spacing="0">
                
                <!-- Search Bar -->
                <Border Background="#F2F2F7" CornerRadius="10" Padding="14,10" Margin="0,0,0,28">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE721;" FontSize="14" Foreground="#6E6E73" Grid.Column="0"/>
                        <TextBox PlaceholderText="Search Files, Clipboard, Devices..." 
                                 BorderThickness="0" Background="Transparent" 
                                 Foreground="#1D1D1F" FontSize="14" 
                                 Grid.Column="1" Margin="8,0,0,0"/>
                    </Grid>
                </Border>

                <!-- Hero Header -->
                <TextBlock Text="Your screens, acting as one." 
                           FontSize="28" FontWeight="Bold" Foreground="#1D1D1F" 
                           CharacterSpacing="-10" Margin="0,0,0,6"/>
                
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,24">
                    <Border Width="8" Height="8" CornerRadius="4" Background="#34C759" VerticalAlignment="Center"/>
                    <TextBlock Text="Connected over Local Wi-Fi." FontSize="14" Foreground="#6E6E73"/>
                </StackPanel>

                <!-- DYNAMIC PEER DISCOVERY & PAIRING SECTION -->
                <TextBlock Text="Devices &amp; Pairing" FontSize="17" FontWeight="Bold" Foreground="#1D1D1F" Margin="0,0,0,14"/>
                <ListView SelectionMode="None" Padding="0" ItemsSource="{x:Bind mgr.Peers, Mode=OneWay}" Margin="0,0,0,28">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="winui:PeerViewModel">
                            <Border Background="#F8F9FB" BorderBrush="#E5E5EA" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,0,10" Tapped="OnPeerCardTapped">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Device Icon -->
                                    <Border Width="44" Height="44" CornerRadius="22" Background="#E3F2FD" Grid.Column="0" Margin="0,0,14,0">
                                        <FontIcon Glyph="&#xE8EA;" FontSize="20" Foreground="#0A84FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    
                                    <!-- Device Info -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                        <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" Foreground="#1D1D1F"/>
                                        <TextBlock Text="{x:Bind ConnectionText, Mode=OneWay}" FontSize="13" Foreground="#6E6E73"/>
                                    </StackPanel>
                                    
                                    <!-- Action Buttons & PIN -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <!-- PIN Display -->
                                        <StackPanel Visibility="{x:Bind pairingRequested, Mode=OneWay}" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock Text="PIN" FontSize="10" FontWeight="Bold" Foreground="#8E8E93" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{x:Bind pairingPin, Mode=OneWay}" FontSize="18" FontWeight="Bold" Foreground="#1D1D1F"/>
                                        </StackPanel>
                                        
                                        <!-- Accept / Reject Buttons for incoming pairing -->
                                        <Button Content="Accept" Background="#34C759" Foreground="#FFFFFF" CornerRadius="8" Padding="14,6" Visibility="{x:Bind pairingRequested, Mode=OneWay}" Click="OnPairingAcceptClicked"/>
                                        <Button Content="Reject" Background="#FF3B30" Foreground="#FFFFFF" CornerRadius="8" Padding="14,6" Visibility="{x:Bind pairingRequested, Mode=OneWay}" Click="OnPairingRejectClicked"/>
                                        
                                        <!-- Pair Button if not trusted -->
                                        <Button Content="Pair Device" Background="#0A84FF" Foreground="#FFFFFF" CornerRadius="8" Padding="14,6" Visibility="{x:Bind ShowConnectButton, Mode=OneWay}" Click="OnPairDeviceClicked"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Launchpad Section Title -->
                <TextBlock Text="Launchpad" FontSize="17" FontWeight="Bold" Foreground="#1D1D1F" Margin="0,0,0,16"/>

                <!-- 3x2 Launchpad Grid -->
                <Grid Margin="0,0,0,36">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 1. Transfer Files -->
                    <Border Grid.Row="0" Grid.Column="0" Background="#F5F5F7" CornerRadius="16" Padding="20" Margin="0,0,8,16" Tapped="OnTransferFilesTapped">
                        <StackPanel HorizontalAlignment="Center" Spacing="12">
                            <Border Width="52" Height="52" CornerRadius="26" Background="#E3F2FD" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE896;" FontSize="22" Foreground="#0A84FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Transfer Files" FontSize="13.5" FontWeight="SemiBold" Foreground="#1D1D1F" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- 2. Browse Device -->
                    <Border Grid.Row="0" Grid.Column="1" Background="#F5F5F7" CornerRadius="16" Padding="20" Margin="8,0,8,16" Tapped="OnBrowseDeviceTapped">
                        <StackPanel HorizontalAlignment="Center" Spacing="12">
                            <Border Width="52" Height="52" CornerRadius="26" Background="#EDE7F6" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE8F1;" FontSize="22" Foreground="#7C3AED" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Browse Device" FontSize="13.5" FontWeight="SemiBold" Foreground="#1D1D1F" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- 3. Clipboard -->
                    <Border Grid.Row="0" Grid.Column="2" Background="#F5F5F7" CornerRadius="16" Padding="20" Margin="8,0,0,16" Tapped="OnClipboardTapped">
                        <StackPanel HorizontalAlignment="Center" Spacing="12">
                            <Border Width="52" Height="52" CornerRadius="26" Background="#FFEBEE" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE8C8;" FontSize="22" Foreground="#E11D48" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Clipboard" FontSize="13.5" FontWeight="SemiBold" Foreground="#1D1D1F" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- 4. Speed Test -->
                    <Border Grid.Row="1" Grid.Column="0" Background="#F5F5F7" CornerRadius="16" Padding="20" Margin="0,0,8,0" Tapped="OnSpeedTestTapped">
                        <StackPanel HorizontalAlignment="Center" Spacing="12">
                            <Border Width="52" Height="52" CornerRadius="26" Background="#E0F2FE" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE916;" FontSize="22" Foreground="#0284C7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Speed Test" FontSize="13.5" FontWeight="SemiBold" Foreground="#1D1D1F" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- 5. Remote Control -->
                    <Border Grid.Row="1" Grid.Column="1" Background="#F5F5F7" CornerRadius="16" Padding="20" Margin="8,0,8,0" Tapped="OnRemoteControlTapped">
                        <StackPanel HorizontalAlignment="Center" Spacing="12">
                            <Border Width="52" Height="52" CornerRadius="26" Background="#FEF3C7" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE81C;" FontSize="22" Foreground="#D97706" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Remote Control" FontSize="13.5" FontWeight="SemiBold" Foreground="#1D1D1F" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- 6. Settings -->
                    <Border Grid.Row="1" Grid.Column="2" Background="#F5F5F7" CornerRadius="16" Padding="20" Margin="8,0,0,0" Tapped="OnSettingsTapped">
                        <StackPanel HorizontalAlignment="Center" Spacing="12">
                            <Border Width="52" Height="52" CornerRadius="26" Background="#F3F4F6" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE713;" FontSize="22" Foreground="#4B5563" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Settings" FontSize="13.5" FontWeight="SemiBold" Foreground="#1D1D1F" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Recent Activity Section -->
                <TextBlock Text="Recent Activity" FontSize="17" FontWeight="Bold" Foreground="#1D1D1F" Margin="0,0,0,16"/>
                <ListView SelectionMode="None" Padding="0" ItemsSource="{x:Bind mgr.ActivityFeed, Mode=OneWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="winui:ActivityEntry">
                            <Border Background="#F5F5F7" CornerRadius="12" Padding="16,12" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontSize="13.5" FontWeight="SemiBold" Foreground="#1D1D1F"/>
                                        <TextBlock Text="{x:Bind Source, Mode=OneWay}" FontSize="12" Foreground="#8E8E93"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{x:Bind RelativeTime, Mode=OneWay}" FontSize="12" Foreground="#8E8E93" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </ScrollViewer>

        <!-- RIGHT INSPECTOR PANEL (`#FAFAFC`) -->
        <Border Grid.Column="1" Background="#FAFAFC" BorderThickness="1,0,0,0" BorderBrush="#E5E5EA" Padding="24,28,24,28">
            <StackPanel Spacing="28">
                <!-- Device Header -->
                <StackPanel Spacing="6">
                    <TextBlock Text="{x:Bind mgr.SelectedPeer.DisplayName, Mode=OneWay, FallbackValue='No Device Selected'}" FontSize="20" FontWeight="Bold" Foreground="#1D1D1F"/>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Width="8" Height="8" CornerRadius="4" Background="{x:Bind mgr.SelectedPeer.ConnectionColor, Mode=OneWay, FallbackValue='#8E8E93'}" VerticalAlignment="Center"/>
                        <TextBlock Text="{x:Bind mgr.SelectedPeer.ConnectionText, Mode=OneWay, FallbackValue='Offline'}" FontSize="13" Foreground="#6E6E73"/>
                    </StackPanel>
                </StackPanel>

                <!-- Battery Section -->
                <StackPanel Spacing="8">
                    <Grid>
                        <TextBlock Text="Battery" FontSize="13" FontWeight="SemiBold" Foreground="#1D1D1F" HorizontalAlignment="Left"/>
                        <TextBlock Text="{x:Bind mgr.SelectedPeer.BatteryLevel, Mode=OneWay, FallbackValue='--'}" FontSize="13" FontWeight="Bold" Foreground="#1D1D1F" HorizontalAlignment="Right"/>
                    </Grid>
                    <Border Height="8" CornerRadius="4" Background="#E5E5EA">
                        <Border Width="100" Height="8" CornerRadius="4" Background="#34C759" HorizontalAlignment="Left"/>
                    </Border>
                </StackPanel>

                <!-- Storage Section -->
                <StackPanel Spacing="8">
                    <Grid>
                        <TextBlock Text="Storage" FontSize="13" FontWeight="SemiBold" Foreground="#1D1D1F" HorizontalAlignment="Left"/>
                        <TextBlock Text="{x:Bind mgr.SelectedPeer.StorageFreeText, Mode=OneWay, FallbackValue='--'}" FontSize="12.5" FontWeight="Medium" Foreground="#6E6E73" HorizontalAlignment="Right"/>
                    </Grid>
                    <Border Height="8" CornerRadius="4" Background="#E5E5EA">
                        <Grid>
                            <Border Width="40" Height="8" CornerRadius="4,0,0,4" Background="#FF9500" HorizontalAlignment="Left"/>
                            <Border Width="95" Height="8" Background="#AF52DE" HorizontalAlignment="Left" Margin="40,0,0,0"/>
                        </Grid>
                    </Border>
                    <!-- Legend -->
                    <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Border Width="8" Height="8" CornerRadius="4" Background="#FF9500"/>
                            <TextBlock Text="Images" FontSize="11" FontWeight="Medium" Foreground="#6E6E73"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Border Width="8" Height="8" CornerRadius="4" Background="#AF52DE"/>
                            <TextBlock Text="Videos" FontSize="11" FontWeight="Medium" Foreground="#6E6E73"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Border Width="8" Height="8" CornerRadius="4" Background="#E5E5EA"/>
                            <TextBlock Text="Other" FontSize="11" FontWeight="Medium" Foreground="#6E6E73"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Device Controls -->
                <StackPanel Spacing="10" Margin="0,12,0,0">
                    <Button Content="Disconnect" Width="270" Background="#F2F2F7" Foreground="#1D1D1F" CornerRadius="10" Padding="14,10" Click="OnDisconnectClicked"/>
                    <Button Content="Forget Device" Width="270" Background="#FFEBEE" Foreground="#FF3B30" CornerRadius="10" Padding="14,10" Click="OnForgetClicked"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>
