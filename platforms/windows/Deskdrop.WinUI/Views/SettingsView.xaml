<Page
    x:Class="Deskdrop.WinUI.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Deskdrop.WinUI.Views"
    xmlns:winui="using:Deskdrop.WinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32,24,32,36">
        <StackPanel Spacing="24" MaxWidth="900" HorizontalAlignment="Stretch">

            <!-- Header -->
            <StackPanel Spacing="4">
                <TextBlock Text="Settings" FontSize="26" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" CharacterSpacing="-15"/>
                <TextBlock Text="Configure identity, network protocols, sync behaviors, and security" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <!-- 1. IDENTITY & GENERAL SECTION -->
            <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE7F4;" FontSize="15" Foreground="{StaticResource AppAccentBrush}"/>
                    <TextBlock Text="Device &amp; System" FontSize="14.5" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                </StackPanel>

                <Border Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppBorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="20,8">
                    <StackPanel Spacing="0">
                        <!-- Device Name -->
                        <Grid Padding="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Device Name" FontSize="13.5" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="How this PC appears to other Deskdrop devices on the local network" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="{StaticResource AppBorderSubtleBrush}" CornerRadius="6" Padding="12,6">
                                <TextBlock Text="{x:Bind DeviceName, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            </Border>
                        </Grid>

                        <Border Height="1" Background="{StaticResource AppBorderSubtleBrush}"/>

                        <!-- Start on Login -->
                        <Grid Padding="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Launch on Windows Startup" FontSize="13.5" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="Run Deskdrop silently in the background and system tray on boot" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="StartupToggle" Grid.Column="1" MinWidth="0" Toggled="OnStartupToggled"/>
                        </Grid>

                        <Border Height="1" Background="{StaticResource AppBorderSubtleBrush}"/>

                        <!-- Network Rescan -->
                        <Grid Padding="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Rescan Network" FontSize="13.5" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="Force UDP broadcast discovery of nearby Deskdrop peers" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Rescan Now" Style="{StaticResource SecondarySubtleButtonStyle}" Click="OnRescanClicked"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 2. CONTINUITY & SYNC SECTION -->
            <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE8C8;" FontSize="15" Foreground="{StaticResource AppSuccessBrush}"/>
                    <TextBlock Text="Continuity &amp; Sync" FontSize="14.5" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                </StackPanel>

                <Border Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppBorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="20,8">
                    <StackPanel Spacing="0">
                        <!-- Auto Sync Clipboard -->
                        <Grid Padding="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Automatic Clipboard Sync" FontSize="13.5" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="Seamlessly share text and links with trusted connected devices" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind mgr.SyncEnabled, Mode=TwoWay}" MinWidth="0"/>
                        </Grid>

                        <Border Height="1" Background="{StaticResource AppBorderSubtleBrush}"/>

                        <!-- Downloads Folder -->
                        <Grid Padding="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Download Directory" FontSize="13.5" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="Where files received from mobile devices will be saved" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Open Folder" Style="{StaticResource SecondarySubtleButtonStyle}" Click="OnOpenDownloadsClicked"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 3. SECURITY SECTION -->
            <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE72E;" FontSize="15" Foreground="{StaticResource AppWarningBrush}"/>
                    <TextBlock Text="Security &amp; Encryption" FontSize="14.5" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                </StackPanel>

                <Border Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppBorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="20,8">
                    <StackPanel Spacing="0">
                        <!-- TOFU PIN Verification -->
                        <Grid Padding="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="TOFU Security PIN Verification" FontSize="13.5" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="Require matching a 6-digit PIN on both devices before establishing trust" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind mgr.RequireTofuConfirmation, Mode=TwoWay}" MinWidth="0"/>
                        </Grid>

                        <Border Height="1" Background="{StaticResource AppBorderSubtleBrush}"/>

                        <!-- Forget All Devices -->
                        <Grid Padding="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Revoke All Trusted Devices" FontSize="13.5" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="Clear local pairing keys and require re-pairing for all devices" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Revoke All" Style="{StaticResource DestructiveButtonStyle}" Click="OnRevokeAllClicked"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 4. ABOUT & DIAGNOSTICS SECTION -->
            <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE946;" FontSize="15" Foreground="{StaticResource AppCyanBrush}"/>
                    <TextBlock Text="About &amp; Diagnostics" FontSize="14.5" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                </StackPanel>

                <Border Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppBorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="20,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Deskdrop for Windows" FontSize="14" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Version 4.0.0 • Native WinUI 3 &amp; Rust Core" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="Local Daemon: Running (Healthy)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AppSuccessBrush}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="View Logs" Style="{StaticResource SecondarySubtleButtonStyle}" VerticalAlignment="Center" Click="OnViewLogsClicked"/>
                    </Grid>
                </Border>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
