<Window x:Class="Deskdrop.WinUI.Views.IncomingFileBannerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="12">
        <Border CornerRadius="20" Background="#F2FFFFFF" BorderThickness="1" BorderBrush="#E5E5EA">
            <Grid Margin="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Icon -->
                <Grid Grid.Column="0" Width="52" Height="52" VerticalAlignment="Center">
                    <Ellipse Fill="#32ADE6" Width="52" Height="52" />
                    <FontIcon Glyph="&#xED25;" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="24"/>
                </Grid>
                
                <!-- File Info -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock x:Name="TxtFileName" Text="Receiving File..." Foreground="#1C1C1E" FontSize="16" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="TxtSenderName" Text="from Unknown" Foreground="#8E8E93" FontSize="13" Margin="0,2,0,0"/>
                </StackPanel>
                
                <!-- Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Width="44" Height="44" Background="#34C759" BorderThickness="0" Click="BtnAccept_Click" CornerRadius="22">
                        <FontIcon Glyph="&#xE73E;" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
