<Page
    x:Class="Deskdrop.WinUI.Views.RemoteExplorerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Deskdrop.WinUI.Views"
    xmlns:winui="using:Deskdrop.WinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="Transparent">
        <Grid.ColumnDefinitions>
            <!-- Left Library Navigation Shortcuts -->
            <ColumnDefinition Width="210"/>
            <!-- Center File Browser Canvas -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 1. LEFT SHORTCUTS SIDEBAR -->
        <Border Grid.Column="0" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppBorderSubtleBrush}" BorderThickness="0,0,1,0" Padding="14,20,14,20">
            <StackPanel Spacing="6">
                <TextBlock Text="REMOTE STORAGE" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Margin="8,0,0,8" CharacterSpacing="50"/>

                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="10,8" Click="OnShortcutRootClicked">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE8B7;" FontSize="15" Foreground="{StaticResource AppAccentBrush}"/>
                        <TextBlock Text="Root (/)" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>
                </Button>

                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="10,8" Click="OnShortcutDCIMClicked">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE722;" FontSize="15" Foreground="{StaticResource AppWarningBrush}"/>
                        <TextBlock Text="Camera / DCIM" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>
                </Button>

                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="10,8" Click="OnShortcutPicturesClicked">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xEB9F;" FontSize="15" Foreground="{StaticResource AppCyanBrush}"/>
                        <TextBlock Text="Pictures" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>
                </Button>

                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="10,8" Click="OnShortcutDownloadsClicked">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE896;" FontSize="15" Foreground="{StaticResource AppSuccessBrush}"/>
                        <TextBlock Text="Downloads" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>
                </Button>

                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="10,8" Click="OnShortcutDocumentsClicked">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE8A5;" FontSize="15" Foreground="{StaticResource AppVioletBrush}"/>
                        <TextBlock Text="Documents" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>
                </Button>

                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="10,8" Click="OnShortcutMusicClicked">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE8D6;" FontSize="15" Foreground="{StaticResource AppAccentBrush}"/>
                        <TextBlock Text="Music" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>
                </Button>

                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="10,8" Click="OnShortcutMoviesClicked">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE714;" FontSize="15" Foreground="{StaticResource AppWarningBrush}"/>
                        <TextBlock Text="Movies" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- 2. MAIN FILE EXPLORER CANVAS -->
        <Grid Grid.Column="1" Padding="24,20,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Navigation & Path Toolbar -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Back / Up / Refresh Buttons -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" Margin="0,0,12,0">
                    <Button Width="36" Height="36" Padding="0" CornerRadius="18" Background="{StaticResource AppSurfaceBrush}" BorderThickness="1" BorderBrush="{StaticResource AppBorderSubtleBrush}" ToolTipService.ToolTip="Back / Up Directory" Click="OnBackClicked">
                        <FontIcon Glyph="&#xE72B;" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    </Button>
                    <Button Width="36" Height="36" Padding="0" CornerRadius="18" Background="{StaticResource AppSurfaceBrush}" BorderThickness="1" BorderBrush="{StaticResource AppBorderSubtleBrush}" ToolTipService.ToolTip="Refresh Files" Click="OnRefreshClicked">
                        <FontIcon Glyph="&#xE72C;" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    </Button>
                </StackPanel>

                <!-- Breadcrumb / Path Bar -->
                <Border Grid.Column="1" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppBorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8B7;" FontSize="14" Foreground="{StaticResource AppAccentBrush}" Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBox x:Name="PathBox" Text="/" FontSize="13" BorderThickness="0" Background="Transparent" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Grid.Column="1" KeyDown="OnPathKeyDown"/>
                        <Button Grid.Column="2" Content="Go" Padding="10,3" FontSize="11.5" Style="{StaticResource PrimaryAccentButtonStyle}" Click="OnGoClicked"/>
                    </Grid>
                </Border>

                <!-- Upload / Send Files Button -->
                <Button Grid.Column="2" Style="{StaticResource PrimaryAccentButtonStyle}" Margin="12,0,0,0" Click="OnSendFilesClicked">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE898;" FontSize="13" Foreground="#FFFFFF"/>
                        <TextBlock Text="Upload File" FontSize="13"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Device Connection Status Bar -->
            <Grid Grid.Row="1" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Browsing:" FontSize="12.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    <TextBlock Text="{x:Bind mgr.SelectedPeer.DisplayName, Mode=OneWay}" FontSize="12.5" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    <TextBlock Text="•" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    <TextBlock Text="{x:Bind RemoteFiles.Count, Mode=OneWay}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource AppAccentBrush}"/>
                    <TextBlock Text="items" FontSize="12.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Grid>

            <!-- Files List -->
            <ListView Grid.Row="2" SelectionMode="None" Padding="0" ItemsSource="{x:Bind RemoteFiles, Mode=OneWay}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="winui:RemoteFile">
                        <Border Background="{StaticResource AppSurfaceBrush}" 
                                BorderBrush="{StaticResource AppBorderSubtleBrush}" 
                                BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Type Icon -->
                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="{StaticResource AppBorderSubtleBrush}" Margin="0,0,12,0">
                                    <FontIcon Glyph="{x:Bind name, Converter={StaticResource FileTypeToGlyphConverter}, Mode=OneWay}" FontSize="16" Foreground="{StaticResource AppAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Name & Modified Date -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind name, Mode=OneWay}" FontSize="13.5" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{x:Bind FormattedDate, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                </StackPanel>

                                <!-- Formatted Size -->
                                <TextBlock Grid.Column="2" Text="{x:Bind FormattedSize, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>

                                <!-- Action Buttons -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <!-- Open Directory -->
                                    <Button Content="Open" Style="{StaticResource PrimaryAccentButtonStyle}" Padding="10,5" FontSize="12" Visibility="{x:Bind is_dir, Converter={StaticResource BoolToVisibleConverter}, Mode=OneWay}" Click="OnItemClicked"/>
                                    <!-- Download File -->
                                    <Button Content="Download" Style="{StaticResource SecondarySubtleButtonStyle}" Padding="10,5" FontSize="12" Visibility="{x:Bind is_dir, Converter={StaticResource InverseBoolToVisibilityConverter}, Mode=OneWay}" Click="OnDownloadClicked"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
