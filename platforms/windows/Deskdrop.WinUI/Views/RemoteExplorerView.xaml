<Page
    x:Class="Deskdrop.WinUI.Views.RemoteExplorerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Deskdrop.WinUI.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="#FFFFFF">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <!-- CENTER REMOTE EXPLORER CONTENT (`input_file_3.png`) -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Header Bar (`input_file_3.png`) -->
            <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="#E5E5EA" Padding="28,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="&lt;" FontSize="16" FontWeight="Bold" Foreground="#1D1D1F"/>
                        <TextBlock Text="OnePlus Nord 4" FontSize="16" FontWeight="Bold" Foreground="#1D1D1F"/>
                        <Border Width="6" Height="6" CornerRadius="3" Background="#34C759" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Border Grid.Column="1" Background="#F2F2F7" CornerRadius="8" Padding="12,6" MaxWidth="320" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE721;" FontSize="13" Foreground="#6E6E73"/>
                            <TextBox PlaceholderText="Search files, extensions, dates..." BorderThickness="0" Background="Transparent" Foreground="#1D1D1F" FontSize="13"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                        <TextBlock Text="✓ Select" FontSize="13" FontWeight="SemiBold" Foreground="#6E6E73" VerticalAlignment="Center"/>
                        <Button Content="📁 Import Mac Files..." Background="#0A84FF" Foreground="#FFFFFF" BorderThickness="0" CornerRadius="8" Padding="14,6"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Explorer Body (Left Library Sidebar + Center Grid) -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Library / Locations Sub-Sidebar (`input_file_3.png`) -->
                <Border Grid.Column="0" Background="#FAFAFC" BorderThickness="0,0,1,0" BorderBrush="#E5E5EA" Padding="12,20">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Library" FontSize="11" FontWeight="Bold" Foreground="#8E8E93" Margin="6,0,0,4"/>
                        
                        <Border Background="#0A84FF" CornerRadius="8" Padding="10,8">
                            <Grid>
                                <TextBlock Text="All Files" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Left"/>
                                <TextBlock Text="8,607" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                        <Border Padding="10,6">
                            <Grid>
                                <TextBlock Text="Images" FontSize="13" FontWeight="SemiBold" Foreground="#1D1D1F" HorizontalAlignment="Left"/>
                                <TextBlock Text="3,941" FontSize="12" Foreground="#6E6E73" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                        <Border Padding="10,6">
                            <Grid>
                                <TextBlock Text="Videos" FontSize="13" FontWeight="SemiBold" Foreground="#1D1D1F" HorizontalAlignment="Left"/>
                                <TextBlock Text="128" FontSize="12" Foreground="#6E6E73" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                        <Border Padding="10,6">
                            <Grid>
                                <TextBlock Text="Audio" FontSize="13" FontWeight="SemiBold" Foreground="#1D1D1F" HorizontalAlignment="Left"/>
                                <TextBlock Text="690" FontSize="12" Foreground="#6E6E73" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                        <Border Padding="10,6">
                            <Grid>
                                <TextBlock Text="Documents" FontSize="13" FontWeight="SemiBold" Foreground="#1D1D1F" HorizontalAlignment="Left"/>
                                <TextBlock Text="3,132" FontSize="12" Foreground="#6E6E73" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                        <Border Padding="10,6">
                            <Grid>
                                <TextBlock Text="APKs &amp; Apps" FontSize="13" FontWeight="SemiBold" Foreground="#1D1D1F" HorizontalAlignment="Left"/>
                                <TextBlock Text="23" FontSize="12" Foreground="#6E6E73" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <TextBlock Text="Locations" FontSize="11" FontWeight="Bold" Foreground="#8E8E93" Margin="6,16,0,4"/>
                        <Border Background="#E6F2FF" CornerRadius="8" Padding="10,8">
                            <TextBlock Text="All Locations" FontSize="13" FontWeight="SemiBold" Foreground="#0A84FF"/>
                        </Border>
                        <Border Padding="10,6">
                            <Grid>
                                <TextBlock Text="Downloads" FontSize="13" FontWeight="SemiBold" Foreground="#1D1D1F" HorizontalAlignment="Left"/>
                                <TextBlock Text="3,545" FontSize="12" Foreground="#6E6E73" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                        <Border Padding="10,6">
                            <Grid>
                                <TextBlock Text="WhatsApp" FontSize="13" FontWeight="SemiBold" Foreground="#1D1D1F" HorizontalAlignment="Left"/>
                                <TextBlock Text="2,534" FontSize="12" Foreground="#6E6E73" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Center Grid Area (`input_file_3.png`) -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="28,20">
                    <StackPanel Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Today" FontSize="14" FontWeight="Bold" Foreground="#1D1D1F"/>
                            <TextBlock Text="5 items" FontSize="13" Foreground="#6E6E73"/>
                        </StackPanel>

                        <!-- 4-Column Grid of Thumbnails -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Thumb 1 -->
                            <Border Grid.Column="0" Background="#F5F5F7" BorderThickness="1" BorderBrush="#E5E5EA" CornerRadius="12" Margin="0,0,8,0" Overflow="Hidden">
                                <StackPanel>
                                    <Border Height="140" Background="#111827" CornerRadius="12,12,0,0">
                                        <TextBlock Text="📱" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF"/>
                                    </Border>
                                    <StackPanel Padding="10,8">
                                        <TextBlock Text="Screenshot...efd7459.jpg" FontSize="12.5" FontWeight="SemiBold" Foreground="#1D1D1F" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="372 KB" FontSize="11" Foreground="#6E6E73"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Thumb 2 -->
                            <Border Grid.Column="1" Background="#F5F5F7" BorderThickness="1" BorderBrush="#E5E5EA" CornerRadius="12" Margin="4,0,4,0" Overflow="Hidden">
                                <StackPanel>
                                    <Border Height="140" Background="#065F46" CornerRadius="12,12,0,0">
                                        <TextBlock Text="📱" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF"/>
                                    </Border>
                                    <StackPanel Padding="10,8">
                                        <TextBlock Text="Screenshot...efd7459.jpg" FontSize="12.5" FontWeight="SemiBold" Foreground="#1D1D1F" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="337 KB" FontSize="11" Foreground="#6E6E73"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Thumb 3 -->
                            <Border Grid.Column="2" Background="#F5F5F7" BorderThickness="1" BorderBrush="#E5E5EA" CornerRadius="12" Margin="4,0,4,0" Overflow="Hidden">
                                <StackPanel>
                                    <Border Height="140" Background="#15803D" CornerRadius="12,12,0,0">
                                        <TextBlock Text="⚽" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF"/>
                                    </Border>
                                    <StackPanel Padding="10,8">
                                        <TextBlock Text="“This wasn’...(1) (1).mp4" FontSize="12.5" FontWeight="SemiBold" Foreground="#1D1D1F" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="12.6 MB" FontSize="11" Foreground="#6E6E73"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Thumb 4 -->
                            <Border Grid.Column="3" Background="#F5F5F7" BorderThickness="1" BorderBrush="#E5E5EA" CornerRadius="12" Margin="8,0,0,0" Overflow="Hidden">
                                <StackPanel>
                                    <Border Height="140" Background="#F3F4F6" CornerRadius="12,12,0,0">
                                        <TextBlock Text="📄" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#4B5563"/>
                                    </Border>
                                    <StackPanel Padding="10,8">
                                        <TextBlock Text="Chinmay_K...Resume.pdf" FontSize="12.5" FontWeight="SemiBold" Foreground="#1D1D1F" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="214 KB" FontSize="11" Foreground="#6E6E73"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- RIGHT INSPECTOR PANEL (`input_file_3.png`) -->
        <Border Grid.Column="1" Background="#FAFAFC" BorderThickness="1,0,0,0" BorderBrush="#E5E5EA" Padding="24,28,24,28">
            <StackPanel Spacing="28">
                <StackPanel Spacing="6">
                    <TextBlock Text="OnePlus Nord 4" FontSize="20" FontWeight="Bold" Foreground="#1D1D1F"/>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Width="8" Height="8" CornerRadius="4" Background="#34C759" VerticalAlignment="Center"/>
                        <TextBlock Text="Connected - Wi-Fi 6 · 192.168.x.x" FontSize="13" Foreground="#6E6E73"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Spacing="8">
                    <Grid>
                        <TextBlock Text="Battery" FontSize="13" FontWeight="SemiBold" Foreground="#1D1D1F" HorizontalAlignment="Left"/>
                        <TextBlock Text="51%" FontSize="13" FontWeight="Bold" Foreground="#1D1D1F" HorizontalAlignment="Right"/>
                    </Grid>
                    <Border Height="8" CornerRadius="4" Background="#E5E5EA">
                        <Border Width="138" Height="8" CornerRadius="4" Background="#34C759" HorizontalAlignment="Left"/>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="8">
                    <Grid>
                        <TextBlock Text="Storage" FontSize="13" FontWeight="SemiBold" Foreground="#1D1D1F" HorizontalAlignment="Left"/>
                        <TextBlock Text="112.9 GB / 219.5 GB" FontSize="12.5" FontWeight="Medium" Foreground="#6E6E73" HorizontalAlignment="Right"/>
                    </Grid>
                    <Border Height="8" CornerRadius="4" Background="#E5E5EA">
                        <Grid>
                            <Border Width="40" Height="8" CornerRadius="4,0,0,4" Background="#FF9500" HorizontalAlignment="Left"/>
                            <Border Width="95" Height="8" Background="#AF52DE" HorizontalAlignment="Left" Margin="40,0,0,0"/>
                        </Grid>
                    </Border>
                    <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Border Width="8" Height="8" CornerRadius="4" Background="#FF9500"/>
                            <TextBlock Text="Images" FontSize="11" FontWeight="Medium" Foreground="#6E6E73"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Border Width="8" Height="8" CornerRadius="4" Background="#AF52DE"/>
                            <TextBlock Text="Videos" FontSize="11" FontWeight="Medium" Foreground="#6E6E73"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Border Width="8" Height="8" CornerRadius="4" Background="#E5E5EA"/>
                            <TextBlock Text="Other" FontSize="11" FontWeight="Medium" Foreground="#6E6E73"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>
