<Page
    x:Class="Deskdrop.WinUI.Views.ClipboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Deskdrop.WinUI.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="#FFFFFF">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <!-- CENTER CLIPBOARD CONTENT (`input_file_0.png`) -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="40,28,40,40">
            <StackPanel Spacing="0">
                <!-- Top Search Bar with Hotkey Badge -->
                <Border Background="#F2F2F7" CornerRadius="10" Padding="14,10" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE721;" FontSize="14" Foreground="#6E6E73" Grid.Column="0"/>
                        <TextBox PlaceholderText="Search copied text, links, files, and images across devices..." 
                                 BorderThickness="0" Background="Transparent" 
                                 Foreground="#1D1D1F" FontSize="14" 
                                 Grid.Column="1" Margin="8,0,0,0"/>
                        <Border Grid.Column="2" Background="#FFFFFF" BorderThickness="1" BorderBrush="#E5E5EA" CornerRadius="5" Padding="6,2">
                            <TextBlock Text="⌘F" FontSize="11" FontWeight="SemiBold" Foreground="#6E6E73"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Filter Chips -->
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,24">
                    <Border Background="#0A84FF" CornerRadius="16" Padding="14,6">
                        <TextBlock Text="All" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                    </Border>
                    <Border Background="#F2F2F7" CornerRadius="16" Padding="14,6">
                        <TextBlock Text="Text" FontSize="13" FontWeight="SemiBold" Foreground="#1D1D1F"/>
                    </Border>
                    <Border Background="#F2F2F7" CornerRadius="16" Padding="14,6">
                        <TextBlock Text="Image" FontSize="13" FontWeight="SemiBold" Foreground="#1D1D1F"/>
                    </Border>
                    <Border Background="#F2F2F7" CornerRadius="16" Padding="14,6">
                        <TextBlock Text="File" FontSize="13" FontWeight="SemiBold" Foreground="#1D1D1F"/>
                    </Border>
                </StackPanel>

                <!-- 2-Column Clipboard History Grid (`input_file_0.png`) -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Card 1 -->
                    <Border Grid.Row="0" Grid.Column="0" Background="#FFFFFF" BorderThickness="1" BorderBrush="#E5E5EA" CornerRadius="12" Margin="0,0,7,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#D1D5DB" CornerRadius="12,0,0,12"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" Padding="14">
                                <Border Width="36" Height="36" CornerRadius="8" Background="#F2F2F7">
                                    <FontIcon Glyph="&#xE701;" FontSize="16" Foreground="#6E6E73" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="[realme P3 5G] disconnected:..." FontSize="13.5" FontWeight="SemiBold" Foreground="#1D1D1F"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="📴 Connection" FontSize="11.5" FontWeight="SemiBold" Foreground="#8E8E93"/>
                                        <TextBlock Text="• real...P3 5G · 21 min ago" FontSize="11.5" Foreground="#6E6E73"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Card 2 -->
                    <Border Grid.Row="0" Grid.Column="1" Background="#FFFFFF" BorderThickness="1" BorderBrush="#E5E5EA" CornerRadius="12" Margin="7,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#34C759" CornerRadius="12,0,0,12"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" Padding="14">
                                <Border Width="36" Height="36" CornerRadius="8" Background="#F2F2F7">
                                    <FontIcon Glyph="&#xE701;" FontSize="16" Foreground="#6E6E73" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="[realme P3 5G] connected" FontSize="13.5" FontWeight="SemiBold" Foreground="#1D1D1F"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="🟢 Connection" FontSize="11.5" FontWeight="SemiBold" Foreground="#34C759"/>
                                        <TextBlock Text="• real...P3 5G · 21 min ago" FontSize="11.5" Foreground="#6E6E73"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Card 3 -->
                    <Border Grid.Row="1" Grid.Column="0" Background="#FFFFFF" BorderThickness="1" BorderBrush="#E5E5EA" CornerRadius="12" Margin="0,0,7,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#D1D5DB" CornerRadius="12,0,0,12"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" Padding="14">
                                <Border Width="36" Height="36" CornerRadius="8" Background="#F2F2F7">
                                    <FontIcon Glyph="&#xE701;" FontSize="16" Foreground="#6E6E73" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="[realme P3 5G] disconnected: r..." FontSize="13.5" FontWeight="SemiBold" Foreground="#1D1D1F"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="📴 Connection" FontSize="11.5" FontWeight="SemiBold" Foreground="#8E8E93"/>
                                        <TextBlock Text="• real...P3 5G · 21 min ago" FontSize="11.5" Foreground="#6E6E73"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Card 4 -->
                    <Border Grid.Row="1" Grid.Column="1" Background="#FFFFFF" BorderThickness="1" BorderBrush="#E5E5EA" CornerRadius="12" Margin="7,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#34C759" CornerRadius="12,0,0,12"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" Padding="14">
                                <Border Width="36" Height="36" CornerRadius="8" Background="#F2F2F7">
                                    <FontIcon Glyph="&#xE701;" FontSize="16" Foreground="#6E6E73" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="[realme P3 5G] connected" FontSize="13.5" FontWeight="SemiBold" Foreground="#1D1D1F"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="🟢 Connection" FontSize="11.5" FontWeight="SemiBold" Foreground="#34C759"/>
                                        <TextBlock Text="• real...P3 5G · 21 min ago" FontSize="11.5" Foreground="#6E6E73"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- RIGHT INSPECTOR PANEL (`input_file_0.png`) -->
        <Border Grid.Column="1" Background="#FAFAFC" BorderThickness="1,0,0,0" BorderBrush="#E5E5EA" Padding="24,28,24,28">
            <StackPanel Spacing="28">
                <StackPanel Spacing="6">
                    <TextBlock Text="OnePlus Nord 4" FontSize="20" FontWeight="Bold" Foreground="#1D1D1F"/>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Width="8" Height="8" CornerRadius="4" Background="#34C759" VerticalAlignment="Center"/>
                        <TextBlock Text="Connected - Wi-Fi 6 · 192.168.x.x" FontSize="13" Foreground="#6E6E73"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Spacing="8">
                    <Grid>
                        <TextBlock Text="Battery" FontSize="13" FontWeight="SemiBold" Foreground="#1D1D1F" HorizontalAlignment="Left"/>
                        <TextBlock Text="50%" FontSize="13" FontWeight="Bold" Foreground="#1D1D1F" HorizontalAlignment="Right"/>
                    </Grid>
                    <Border Height="8" CornerRadius="4" Background="#E5E5EA">
                        <Border Width="135" Height="8" CornerRadius="4" Background="#34C759" HorizontalAlignment="Left"/>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="8">
                    <Grid>
                        <TextBlock Text="Storage" FontSize="13" FontWeight="SemiBold" Foreground="#1D1D1F" HorizontalAlignment="Left"/>
                        <TextBlock Text="112.9 GB / 219.5 GB" FontSize="12.5" FontWeight="Medium" Foreground="#6E6E73" HorizontalAlignment="Right"/>
                    </Grid>
                    <Border Height="8" CornerRadius="4" Background="#E5E5EA">
                        <Grid>
                            <Border Width="40" Height="8" CornerRadius="4,0,0,4" Background="#FF9500" HorizontalAlignment="Left"/>
                            <Border Width="95" Height="8" Background="#AF52DE" HorizontalAlignment="Left" Margin="40,0,0,0"/>
                        </Grid>
                    </Border>
                    <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Border Width="8" Height="8" CornerRadius="4" Background="#FF9500"/>
                            <TextBlock Text="Images" FontSize="11" FontWeight="Medium" Foreground="#6E6E73"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Border Width="8" Height="8" CornerRadius="4" Background="#AF52DE"/>
                            <TextBlock Text="Videos" FontSize="11" FontWeight="Medium" Foreground="#6E6E73"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Border Width="8" Height="8" CornerRadius="4" Background="#E5E5EA"/>
                            <TextBlock Text="Other" FontSize="11" FontWeight="Medium" Foreground="#6E6E73"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>
