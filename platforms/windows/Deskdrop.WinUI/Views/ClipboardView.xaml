<Page
    x:Class="Deskdrop.WinUI.Views.ClipboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Deskdrop.WinUI.Views"
    xmlns:winui="using:Deskdrop.WinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="#FFFFFF">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <!-- CENTER CLIPBOARD CONTENT -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="40,28,40,40">
            <StackPanel Spacing="0">
                <!-- Top Search Bar -->
                <Border Background="#F2F2F7" CornerRadius="10" Padding="14,10" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE721;" FontSize="14" Foreground="#6E6E73" Grid.Column="0"/>
                        <TextBox x:Name="SearchBox" PlaceholderText="Search copied text, links, files, and images across devices..." 
                                 BorderThickness="0" Background="Transparent" 
                                 Foreground="#1D1D1F" FontSize="14" 
                                 Grid.Column="1" Margin="8,0,0,0"
                                 TextChanged="OnSearchTextChanged"/>
                        <Border Grid.Column="2" Background="#FFFFFF" BorderThickness="1" BorderBrush="#E5E5EA" CornerRadius="5" Padding="6,2">
                            <TextBlock Text="⌘F" FontSize="11" FontWeight="SemiBold" Foreground="#6E6E73"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Pending Approvals Section -->
                <StackPanel Visibility="{x:Bind mgr.HasPendingClipboards, Mode=OneWay}" Margin="0,0,0,24">
                    <TextBlock Text="PENDING REMOTE CLIPBOARDS" FontSize="11" FontWeight="Bold" Foreground="#0055CC" CharacterSpacing="60" Margin="0,0,0,10"/>
                    <ItemsControl ItemsSource="{x:Bind mgr.PendingClipboards, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="winui:PendingClipboard">
                                <Border Background="#EBF4FF" BorderBrush="#B9D5FF" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" Background="#0055CC" Margin="0,0,14,0">
                                            <FontIcon Glyph="&#xE8C8;" FontSize="18" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                            <TextBlock Text="{x:Bind Preview, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" Foreground="#1D1D1F" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{x:Bind from_device, Mode=OneWay}" FontSize="12.5" Foreground="#0055CC"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="Apply to Windows Clipboard" Background="#0055CC" Foreground="#FFFFFF" CornerRadius="8" Padding="14,8" VerticalAlignment="Center" Click="OnApplyPendingClicked"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Filter Chips -->
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,24">
                    <Button x:Name="ChipAll" Content="All" Background="#0A84FF" Foreground="#FFFFFF" CornerRadius="16" Padding="14,6" BorderThickness="0" Click="OnFilterChipClicked"/>
                    <Button x:Name="ChipText" Content="Text" Background="#F2F2F7" Foreground="#1D1D1F" CornerRadius="16" Padding="14,6" BorderThickness="0" Click="OnFilterChipClicked"/>
                    <Button x:Name="ChipImage" Content="Image" Background="#F2F2F7" Foreground="#1D1D1F" CornerRadius="16" Padding="14,6" BorderThickness="0" Click="OnFilterChipClicked"/>
                    <Button x:Name="ChipFile" Content="File" Background="#F2F2F7" Foreground="#1D1D1F" CornerRadius="16" Padding="14,6" BorderThickness="0" Click="OnFilterChipClicked"/>
                </StackPanel>

                <!-- Filtered Clipboard History Feed -->
                <ItemsControl ItemsSource="{x:Bind FilteredFeed, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="winui:ActivityEntry">
                            <Border Background="#F8F9FB" BorderBrush="#E5E5EA" BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Icon -->
                                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10" Background="#F2F2F7" Margin="0,0,14,0">
                                        <FontIcon Glyph="&#xE8C8;" FontSize="18" Foreground="#6E6E73" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    
                                    <!-- Content -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                        <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" Foreground="#1D1D1F" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border CornerRadius="4" Padding="6,2" Background="#E5E5EA">
                                                <TextBlock Text="{x:Bind TypeLabel, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="#4B5563"/>
                                            </Border>
                                            <TextBlock Text="•" FontSize="12" Foreground="#8E8E93" VerticalAlignment="Center"/>
                                            <TextBlock Text="{x:Bind Source, Mode=OneWay}" FontSize="12" Foreground="#6E6E73" VerticalAlignment="Center"/>
                                            <TextBlock Text="•" FontSize="12" Foreground="#8E8E93" VerticalAlignment="Center"/>
                                            <TextBlock Text="{x:Bind RelativeTime, Mode=OneWay}" FontSize="12" Foreground="#8E8E93" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                    
                                    <!-- Apply Button if actionable -->
                                    <Button Grid.Column="2" Content="Apply" Background="#34C759" Foreground="#FFFFFF" CornerRadius="8" Padding="12,6" VerticalAlignment="Center" Visibility="{x:Bind CanApply, Mode=OneWay}" Click="OnApplyActivityClicked"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- RIGHT INSPECTOR PANEL (`#FAFAFC`) -->
        <Border Grid.Column="1" Background="#FAFAFC" BorderThickness="1,0,0,0" BorderBrush="#E5E5EA" Padding="24,28,24,28">
            <StackPanel Spacing="28">
                <!-- Device Header -->
                <StackPanel Spacing="6">
                    <TextBlock Text="{x:Bind mgr.SelectedPeer.DisplayName, Mode=OneWay, FallbackValue='No Device Selected'}" FontSize="20" FontWeight="Bold" Foreground="#1D1D1F"/>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Width="8" Height="8" CornerRadius="4" Background="{x:Bind mgr.SelectedPeer.ConnectionColor, Mode=OneWay, FallbackValue='#8E8E93'}" VerticalAlignment="Center"/>
                        <TextBlock Text="{x:Bind mgr.SelectedPeer.ConnectionText, Mode=OneWay, FallbackValue='Offline'}" FontSize="13" Foreground="#6E6E73"/>
                    </StackPanel>
                </StackPanel>

                <!-- Battery Section -->
                <StackPanel Spacing="8">
                    <Grid>
                        <TextBlock Text="Battery" FontSize="13" FontWeight="SemiBold" Foreground="#1D1D1F" HorizontalAlignment="Left"/>
                        <TextBlock Text="{x:Bind mgr.SelectedPeer.BatteryLevel, Mode=OneWay, FallbackValue='--'}" FontSize="13" FontWeight="Bold" Foreground="#1D1D1F" HorizontalAlignment="Right"/>
                    </Grid>
                    <Border Height="8" CornerRadius="4" Background="#E5E5EA">
                        <Border Width="100" Height="8" CornerRadius="4" Background="#34C759" HorizontalAlignment="Left"/>
                    </Border>
                </StackPanel>

                <!-- Storage Section -->
                <StackPanel Spacing="8">
                    <Grid>
                        <TextBlock Text="Storage" FontSize="13" FontWeight="SemiBold" Foreground="#1D1D1F" HorizontalAlignment="Left"/>
                        <TextBlock Text="{x:Bind mgr.SelectedPeer.StorageFreeText, Mode=OneWay, FallbackValue='--'}" FontSize="12.5" FontWeight="Medium" Foreground="#6E6E73" HorizontalAlignment="Right"/>
                    </Grid>
                    <Border Height="8" CornerRadius="4" Background="#E5E5EA">
                        <Grid>
                            <Border Width="40" Height="8" CornerRadius="4,0,0,4" Background="#FF9500" HorizontalAlignment="Left"/>
                            <Border Width="95" Height="8" Background="#AF52DE" HorizontalAlignment="Left" Margin="40,0,0,0"/>
                        </Grid>
                    </Border>
                    <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Border Width="8" Height="8" CornerRadius="4" Background="#FF9500"/>
                            <TextBlock Text="Images" FontSize="11" FontWeight="Medium" Foreground="#6E6E73"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Border Width="8" Height="8" CornerRadius="4" Background="#AF52DE"/>
                            <TextBlock Text="Videos" FontSize="11" FontWeight="Medium" Foreground="#6E6E73"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Border Width="8" Height="8" CornerRadius="4" Background="#E5E5EA"/>
                            <TextBlock Text="Other" FontSize="11" FontWeight="Medium" Foreground="#6E6E73"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>
