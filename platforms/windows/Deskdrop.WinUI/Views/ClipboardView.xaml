<Page
    x:Class="Deskdrop.WinUI.Views.ClipboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Deskdrop.WinUI.Views"
    xmlns:winui="using:Deskdrop.WinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32,24,32,36">
        <StackPanel Spacing="20" MaxWidth="1100" HorizontalAlignment="Stretch">

            <!-- Top Header & Search Bar -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Clipboard Bridge" FontSize="26" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" CharacterSpacing="-15"/>
                    <TextBlock Text="Cross-device clipboard history and real-time synchronization" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <!-- Push Clipboard Quick Button -->
                <Button Grid.Column="1" Style="{StaticResource PrimaryAccentButtonStyle}" VerticalAlignment="Center" Click="OnPushLocalClipboardClicked">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8C8;" FontSize="13" Foreground="#FFFFFF"/>
                        <TextBlock Text="Push Clipboard" FontSize="13"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Search & Shortcut Bar -->
            <Border Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppBorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="14,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE721;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBox x:Name="SearchBox" PlaceholderText="Search copied text, links, code snippets, and files..." 
                             BorderThickness="0" Background="Transparent" 
                             Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="13.5" 
                             Grid.Column="1" VerticalAlignment="Center"
                             TextChanged="OnSearchTextChanged"/>
                    <Border Grid.Column="2" Background="{StaticResource AppBorderSubtleBrush}" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                        <TextBlock Text="Ctrl+F" FontSize="10.5" FontWeight="Bold" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    </Border>
                </Grid>
            </Border>

            <!-- 1. PENDING REMOTE CLIPBOARDS BANNER -->
            <StackPanel Visibility="{x:Bind mgr.HasPendingClipboards, Converter={StaticResource BoolToVisibleConverter}, Mode=OneWay}" Spacing="10">
                <TextBlock Text="PENDING REMOTE CLIPBOARDS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AppAccentBrush}" CharacterSpacing="60"/>
                <ListView SelectionMode="None" Padding="0" ItemsSource="{x:Bind mgr.PendingClipboards, Mode=OneWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="winui:PendingClipboard">
                            <Border Background="{StaticResource AppAccentSubtleBrush}" BorderBrush="{StaticResource AppAccentBrush}" BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" Background="{StaticResource AppAccentBrush}" Margin="0,0,14,0">
                                        <FontIcon Glyph="&#xE8C8;" FontSize="18" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                        <TextBlock Text="{x:Bind Preview, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{x:Bind from_device, Mode=OneWay}" FontSize="12" Foreground="{StaticResource AppAccentBrush}"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="Apply to Windows Clipboard" Style="{StaticResource PrimaryAccentButtonStyle}" VerticalAlignment="Center" Click="OnApplyPendingClicked"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>

            <!-- 2. FILTER CHIPS -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="ChipAll" Content="All" Background="{StaticResource AppAccentBrush}" Foreground="#FFFFFF" CornerRadius="16" Padding="14,6" BorderThickness="0" Click="OnFilterChipClicked"/>
                <Button x:Name="ChipText" Content="Text" Background="{StaticResource AppSurfaceBrush}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" CornerRadius="16" Padding="14,6" BorderThickness="1" BorderBrush="{StaticResource AppBorderSubtleBrush}" Click="OnFilterChipClicked"/>
                <Button x:Name="ChipImage" Content="Image" Background="{StaticResource AppSurfaceBrush}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" CornerRadius="16" Padding="14,6" BorderThickness="1" BorderBrush="{StaticResource AppBorderSubtleBrush}" Click="OnFilterChipClicked"/>
                <Button x:Name="ChipFile" Content="File" Background="{StaticResource AppSurfaceBrush}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" CornerRadius="16" Padding="14,6" BorderThickness="1" BorderBrush="{StaticResource AppBorderSubtleBrush}" Click="OnFilterChipClicked"/>
            </StackPanel>

            <!-- 3. CLIPBOARD HISTORY STREAM -->
            <ListView SelectionMode="None" Padding="0" ItemsSource="{x:Bind FilteredFeed, Mode=OneWay}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="winui:ActivityEntry">
                        <Border Background="{StaticResource AppSurfaceBrush}" 
                                BorderBrush="{StaticResource AppBorderSubtleBrush}" 
                                BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- Content Type Icon -->
                                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10" Background="{StaticResource AppBorderSubtleBrush}" Margin="0,0,14,0">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                
                                <!-- Content Body -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Border CornerRadius="4" Padding="6,2" Background="{StaticResource AppBorderSubtleBrush}">
                                            <TextBlock Text="{x:Bind TypeLabel, Mode=OneWay}" FontSize="10.5" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </Border>
                                        <TextBlock Text="•" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                        <TextBlock Text="{x:Bind Source, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="•" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                        <TextBlock Text="{x:Bind RelativeTime, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                                
                                <!-- Action Buttons -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Content="Copy" Style="{StaticResource SecondarySubtleButtonStyle}" Click="OnCopyActivityTextClicked"/>
                                    <Button Content="Apply" Style="{StaticResource PrimaryAccentButtonStyle}" Background="{StaticResource AppSuccessBrush}" Visibility="{x:Bind CanApply, Converter={StaticResource BoolToVisibleConverter}, Mode=OneWay}" Click="OnApplyActivityClicked"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

        </StackPanel>
    </ScrollViewer>
</Page>

