<Page
    x:Class="Deskdrop.WinUI.Views.TransfersView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Deskdrop.WinUI.Views"
    xmlns:winui="using:Deskdrop.WinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <!-- CENTER TRANSFERS CONTENT -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="40,28,40,40">
            <StackPanel Spacing="0">
                <TextBlock Text="Transfers" FontSize="28" FontWeight="Bold" Foreground="#1D1D1F" CharacterSpacing="-10" Margin="0,0,0,6"/>
                <TextBlock Text="Manage active files and view recent history" FontSize="14" Foreground="#6E6E73" Margin="0,0,0,32"/>

                <TextBlock Text="ACTIVE TRANSFERS" FontSize="11" FontWeight="Bold" Foreground="#8E8E93" CharacterSpacing="60" Margin="0,0,0,12"/>
                
                <!-- Active Transfers List -->
                <ItemsControl ItemsSource="{x:Bind mgr.ActiveTransfers, Mode=OneWay}" Margin="0,0,0,32">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="winui:FileTransferState">
                            <Border Background="#F8F9FB" BorderBrush="#E5E5EA" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Icon -->
                                    <Border Grid.Row="0" Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="#E3F2FD" Margin="0,0,16,0">
                                        <FontIcon Glyph="&#xE896;" FontSize="20" Foreground="#0A84FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Details -->
                                    <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                        <TextBlock Text="{x:Bind FileName, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" Foreground="#1D1D1F"/>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" FontSize="13" Foreground="#6E6E73"/>
                                            <TextBlock Text="·" FontSize="13" Foreground="#6E6E73"/>
                                            <TextBlock Text="{x:Bind SizeText, Mode=OneWay}" FontSize="13" Foreground="#6E6E73"/>
                                            <TextBlock Text="·" FontSize="13" Foreground="#6E6E73"/>
                                            <TextBlock Text="{x:Bind SpeedText, Mode=OneWay}" FontSize="13" Foreground="#0A84FF"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Buttons -->
                                    <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <Button Content="Accept" Background="#34C759" Foreground="#FFFFFF" CornerRadius="8" Padding="14,6" Click="OnAcceptClicked"/>
                                        <Button Content="Reject" Background="#FF3B30" Foreground="#FFFFFF" CornerRadius="8" Padding="14,6" Click="OnRejectClicked"/>
                                        <Button Content="Cancel" Background="#F2F2F7" Foreground="#1D1D1F" CornerRadius="8" Padding="14,6" Click="OnCancelClicked"/>
                                    </StackPanel>

                                    <!-- Progress Bar -->
                                    <ProgressBar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Value="{x:Bind Percent, Mode=OneWay}" Maximum="100" Margin="0,14,0,0" Height="6"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="RECENT HISTORY" FontSize="11" FontWeight="Bold" Foreground="#8E8E93" CharacterSpacing="60" Margin="0,0,0,12"/>
                <ItemsControl ItemsSource="{x:Bind mgr.ActivityFeed, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="winui:ActivityEntry">
                            <Border Background="#F5F5F7" CornerRadius="12" Padding="16,14" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="#EDE7F6" Margin="0,0,14,0">
                                        <FontIcon Glyph="&#xE8B7;" FontSize="16" Foreground="#7C3AED" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" Foreground="#1D1D1F"/>
                                        <TextBlock Text="{x:Bind Source, Mode=OneWay}" FontSize="12.5" Foreground="#6E6E73"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{x:Bind RelativeTime, Mode=OneWay}" FontSize="12.5" Foreground="#8E8E93" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- RIGHT INSPECTOR PANEL (`#FAFAFC`) -->
        <Border Grid.Column="1" Background="#FAFAFC" BorderThickness="1,0,0,0" BorderBrush="#E5E5EA" Padding="24,28,24,28">
            <StackPanel Spacing="28">
                <!-- Device Header -->
                <StackPanel Spacing="6">
                    <TextBlock Text="{x:Bind mgr.SelectedPeer.DisplayName, Mode=OneWay, FallbackValue='No Device Selected'}" FontSize="20" FontWeight="Bold" Foreground="#1D1D1F"/>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Width="8" Height="8" CornerRadius="4" Background="{x:Bind mgr.SelectedPeer.ConnectionColor, Mode=OneWay, FallbackValue='#8E8E93'}" VerticalAlignment="Center"/>
                        <TextBlock Text="{x:Bind mgr.SelectedPeer.ConnectionText, Mode=OneWay, FallbackValue='Offline'}" FontSize="13" Foreground="#6E6E73"/>
                    </StackPanel>
                </StackPanel>

                <!-- Battery Section -->
                <StackPanel Spacing="8">
                    <Grid>
                        <TextBlock Text="Battery" FontSize="13" FontWeight="SemiBold" Foreground="#1D1D1F" HorizontalAlignment="Left"/>
                        <TextBlock Text="{x:Bind mgr.SelectedPeer.BatteryLevel, Mode=OneWay, FallbackValue='--'}" FontSize="13" FontWeight="Bold" Foreground="#1D1D1F" HorizontalAlignment="Right"/>
                    </Grid>
                    <Border Height="8" CornerRadius="4" Background="#E5E5EA">
                        <Border Width="100" Height="8" CornerRadius="4" Background="#34C759" HorizontalAlignment="Left"/>
                    </Border>
                </StackPanel>

                <!-- Storage Section -->
                <StackPanel Spacing="8">
                    <Grid>
                        <TextBlock Text="Storage" FontSize="13" FontWeight="SemiBold" Foreground="#1D1D1F" HorizontalAlignment="Left"/>
                        <TextBlock Text="{x:Bind mgr.SelectedPeer.StorageFreeText, Mode=OneWay, FallbackValue='--'}" FontSize="12.5" FontWeight="Medium" Foreground="#6E6E73" HorizontalAlignment="Right"/>
                    </Grid>
                    <Border Height="8" CornerRadius="4" Background="#E5E5EA">
                        <Grid>
                            <Border Width="40" Height="8" CornerRadius="4,0,0,4" Background="#FF9500" HorizontalAlignment="Left"/>
                            <Border Width="95" Height="8" Background="#AF52DE" HorizontalAlignment="Left" Margin="40,0,0,0"/>
                        </Grid>
                    </Border>
                    <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Border Width="8" Height="8" CornerRadius="4" Background="#FF9500"/>
                            <TextBlock Text="Images" FontSize="11" FontWeight="Medium" Foreground="#6E6E73"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Border Width="8" Height="8" CornerRadius="4" Background="#AF52DE"/>
                            <TextBlock Text="Videos" FontSize="11" FontWeight="Medium" Foreground="#6E6E73"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Border Width="8" Height="8" CornerRadius="4" Background="#E5E5EA"/>
                            <TextBlock Text="Other" FontSize="11" FontWeight="Medium" Foreground="#6E6E73"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>
