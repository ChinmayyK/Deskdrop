<Page
    x:Class="Deskdrop.WinUI.Views.TransfersView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Deskdrop.WinUI.Views"
    xmlns:winui="using:Deskdrop.WinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32,24,32,36">
        <StackPanel Spacing="24" MaxWidth="1100" HorizontalAlignment="Stretch">

            <!-- Top Header & Actions -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Transfers &amp; Benchmark" FontSize="26" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" CharacterSpacing="-15"/>
                    <TextBlock Text="Monitor active payloads, verify transfer integrity, and run speed benchmarks" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondarySubtleButtonStyle}" Click="OnOpenDownloadFolderClicked">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xED25;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="Open Downloads" FontSize="13"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PrimaryAccentButtonStyle}" Click="OnSendFilesClicked">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE898;" FontSize="13" Foreground="#FFFFFF"/>
                            <TextBlock Text="Send Files" FontSize="13"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 1. LIVE SPEED TEST CARD (Shown when Speed Test is active) -->
            <ItemsControl ItemsSource="{x:Bind mgr.ActiveSpeedTests, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="winui:SpeedTestState">
                        <Border Background="{StaticResource AppCyanSubtleBrush}" BorderBrush="{StaticResource AppCyanBrush}" BorderThickness="1.5" CornerRadius="14" Padding="20,16" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="48" Height="48" CornerRadius="24" Background="{StaticResource AppCyanBrush}" Margin="0,0,16,0">
                                    <FontIcon Glyph="&#xE916;" FontSize="22" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Text="Local Network Throughput Benchmark" FontSize="15" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="{x:Bind phase, Mode=OneWay}" FontSize="12.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock Text="{x:Bind SpeedText, Mode=OneWay}" FontSize="20" FontWeight="Bold" FontFamily="Segoe UI Variable Display" Foreground="{StaticResource AppCyanBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 2. ACTIVE TRANSFERS SECTION -->
            <StackPanel Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE896;" FontSize="15" Foreground="{StaticResource AppAccentBrush}"/>
                    <TextBlock Text="Active Transfers" FontSize="15" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    <Border Background="{StaticResource AppSurfaceBrush}" CornerRadius="10" Padding="8,2" Margin="4,0,0,0">
                        <TextBlock Text="{x:Bind mgr.ActiveTransfers.Count, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Border>
                </StackPanel>

                <!-- Empty State for Active Transfers -->
                <Border Visibility="{x:Bind mgr.HasActiveTransfers, Converter={StaticResource InverseBoolToVisibilityConverter}, Mode=OneWay}"
                        Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppBorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="28,24">
                    <StackPanel HorizontalAlignment="Center" Spacing="8">
                        <FontIcon Glyph="&#xE896;" FontSize="24" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="No file transfers currently in progress" FontSize="13.5" FontWeight="Medium" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Active Transfers List -->
                <ListView SelectionMode="None" Padding="0" ItemsSource="{x:Bind mgr.ActiveTransfers, Mode=OneWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="winui:FileTransferState">
                            <Border Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppBorderSubtleBrush}" BorderThickness="1" CornerRadius="14" Padding="18,16" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Icon -->
                                    <Border Grid.Row="0" Grid.Column="0" Width="44" Height="44" CornerRadius="10" Background="{StaticResource AppAccentSubtleBrush}" Margin="0,0,16,0">
                                        <FontIcon Glyph="{x:Bind IsDirectory, Converter={StaticResource BoolToFolderIconConverter}, Mode=OneWay}" FontSize="20" Foreground="{StaticResource AppAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Details -->
                                    <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                        <TextBlock Text="{x:Bind FileName, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" FontSize="12.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock Text="•" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                            <TextBlock Text="{x:Bind SizeText, Mode=OneWay}" FontSize="12.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock Text="•" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Visibility="{x:Bind SpeedText, Converter={StaticResource StringToVisibilityConverter}, Mode=OneWay}"/>
                                            <TextBlock Text="{x:Bind SpeedText, Mode=OneWay}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource AppAccentBrush}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Action Buttons -->
                                    <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button Content="Accept" Style="{StaticResource PrimaryAccentButtonStyle}" Background="{StaticResource AppSuccessBrush}" Click="OnAcceptClicked"/>
                                        <Button Content="Reject" Style="{StaticResource DestructiveButtonStyle}" Click="OnRejectClicked"/>
                                        <Button Content="Cancel" Style="{StaticResource SecondarySubtleButtonStyle}" Click="OnCancelClicked"/>
                                    </StackPanel>

                                    <!-- Progress Bar -->
                                    <ProgressBar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Value="{x:Bind PercentFloat, Mode=OneWay}" Maximum="100" Margin="0,14,0,0" Height="5" CornerRadius="2.5"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>

            <!-- 3. COMPLETED TRANSFER HISTORY -->
            <StackPanel Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE81C;" FontSize="15" Foreground="{StaticResource AppAccentBrush}"/>
                    <TextBlock Text="Transfer History" FontSize="15" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                </StackPanel>

                <ListView SelectionMode="None" Padding="0" ItemsSource="{x:Bind mgr.ActivityFeed, Mode=OneWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="winui:ActivityEntry">
                            <Border Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppBorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="{StaticResource AppBorderSubtleBrush}" Margin="0,0,14,0">
                                        <FontIcon Glyph="&#xE896;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontSize="13.5" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{x:Bind Source, Mode=OneWay}" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock Text="•" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                            <TextBlock Text="{x:Bind FormattedSize, Mode=OneWay}" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    
                                    <TextBlock Grid.Column="2" Text="{x:Bind RelativeTime, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>

