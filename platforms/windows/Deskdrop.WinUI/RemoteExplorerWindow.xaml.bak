<Window x:Class="Deskdrop.Windows.RemoteExplorerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        
        xmlns:local="clr-namespace:Deskdrop.WinUI">
<Grid>
<FrameworkElement.Resources>
        <ResourceDictionary Source="AppStyles.xaml" />
    </FrameworkElement.Resources>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" BorderBrush="{StaticResource StrokeSoft}" BorderThickness="0,0,0,1" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                    <Button Style="{StaticResource CircleIconButton}" Click="BtnBack_Click">
                        <FontIcon Glyph="&#xE8A5;" />
                    </Button>
                    <TextBlock Text="{Binding CurrentPath}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Ink}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Grid.Column="2" VerticalAlignment="Center">
                    <ToggleButton x:Name="BtnSelectMode" Style="{StaticResource ModernButton}" Content="Select" Padding="12,6" Checked="BtnSelectMode_CheckedChanged" Unchecked="BtnSelectMode_CheckedChanged"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Loading State -->
        <Grid Grid.Row="1" x:Name="LoadingSpinner" Visibility="Collapsed">
            <TextBlock Text="Loading..." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource InkSoft}" FontSize="14"/>
        </Grid>

        <!-- File List -->
        <ListView x:Name="FileListView" Grid.Row="1" BorderThickness="0" 
                  ItemsSource="{Binding Files}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" DoubleTapped="FileListView_MouseDoubleClick">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <Border Padding="16,12" BorderBrush="{StaticResource StrokeSoft}" BorderThickness="0,0,0,0.5">
                                    <ContentPresenter />
                                </Border>
                                
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        
                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,16,0"
                                  Visibility="{Binding DataContext.IsSelectionMode, ElementName=RootGrid, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                  
                        <!-- Removed Icon -->
                        
                        <TextBlock Grid.Column="2" Text="{Binding display_name}" FontSize="14" Foreground="{StaticResource Ink}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        
                        <TextBlock Grid.Column="3" Text="{Binding FormattedDate}" Foreground="{StaticResource InkSoft}" FontSize="12" VerticalAlignment="Center" Margin="0,0,24,0"/>
                        <TextBlock Grid.Column="4" Text="{Binding FormattedSize}" Foreground="{StaticResource InkSoft}" FontSize="12" VerticalAlignment="Center" TextAlignment="Right"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Batch Action Bar -->
        <Border Grid.Row="2" x:Name="BatchActionBar" BorderBrush="{StaticResource StrokeSoft}" BorderThickness="0,1,0,0" Padding="24,16" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding SelectedCountText}" FontSize="14" FontWeight="Medium" Foreground="{StaticResource Ink}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource ModernButton}" Content="Download" Foreground="White" Padding="16,8" Margin="0,0,8,0" Click="BtnDownloadBatch_Click"/>
                    <Button Style="{StaticResource ModernButton}" Content="Delete" Foreground="White" Padding="16,8" Click="BtnDeleteBatch_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>





