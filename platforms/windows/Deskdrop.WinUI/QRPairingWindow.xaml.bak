<Window x:Class="Deskdrop.Windows.QRPairingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        >
<Border CornerRadius="8" BorderBrush="{StaticResource Stroke}" BorderThickness="1">
<FrameworkElement.Resources>
        <SolidColorBrush x:Key="AppBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Stroke" Color="#E5E5EA"/>
        <SolidColorBrush x:Key="Ink" Color="#111111"/>
        <SolidColorBrush x:Key="InkSoft" Color="#6E6E73"/>
    </FrameworkElement.Resources>
        
        <Grid>
            <!-- Title Bar for Dragging -->
            <Grid VerticalAlignment="Top">
                <Button   FontSize="10" HorizontalAlignment="Right" Foreground="{StaticResource InkSoft}" BorderThickness="0" Click="BtnClose_Click"><FontIcon Glyph="&#xE8A5;" /></Button>
            </Grid>

            <Grid Margin="32,48,32,32">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <TextBlock Text="Magic Link Pair" FontSize="28" FontWeight="Bold" Foreground="{StaticResource Ink}" HorizontalAlignment="Center"/>
                <TextBlock Grid.Row="1" Text="Scan the QR code below from the Deskdrop Android app to pair instantly." 
                           Foreground="{StaticResource InkSoft}" FontSize="14" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,32"/>
                
                <Border Grid.Row="2" CornerRadius="8" Padding="16" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="{StaticResource Stroke}" BorderThickness="1">
                    
                    <Image x:Name="ImgQRCode" Stretch="Uniform"/>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>






