<Window x:Class="Deskdrop.Windows.CameraPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Border CornerRadius="8" BorderBrush="{StaticResource Stroke}" BorderThickness="1">
<FrameworkElement.Resources>
        <SolidColorBrush x:Key="AppBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Stroke" Color="#E5E5EA"/>
    </FrameworkElement.Resources>
        
        <Grid>
            <!-- Title Bar for Dragging -->
            <Grid VerticalAlignment="Top">
                <Button   FontSize="10" HorizontalAlignment="Right" Foreground="#8E8E93" BorderThickness="0" Click="BtnClose_Click"><FontIcon Glyph="&#xE8A5;" /></Button>
            </Grid>

            <Grid Margin="16,40,16,16">
                <Border CornerRadius="8" BorderBrush="{StaticResource Stroke}" BorderThickness="1">
                    <Grid>
                        <Image x:Name="CameraImage" Stretch="Uniform" />
                        <TextBlock x:Name="StatusText" Text="Waiting for stream..." Foreground="#8E8E93" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" FontWeight="Medium" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>






