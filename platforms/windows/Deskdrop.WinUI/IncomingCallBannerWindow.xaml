<Window
    x:Class="Deskdrop.WinUI.IncomingCallBannerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:Deskdrop.WinUI.Services"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Incoming call">

    <!--
        Incoming-call banner. Now uses the single brand accent rather than the
        retired cyan, and a container radius from the scale instead of a
        28px capsule. The pulsing ring stays: this is genuinely a "something
        is happening right now, decide" moment, which is exactly what
        animation should be reserved for.
    -->
    <Grid Background="Transparent">
        <Border x:Name="AppTitleBar" Height="1" VerticalAlignment="Top" Background="Transparent" />

        <Border Background="{ThemeResource AppSurfaceElevatedBrush}"
                CornerRadius="{StaticResource RadiusLarge}"
                BorderThickness="1"
                BorderBrush="{ThemeResource AppBorderStrongBrush}"
                Margin="12"
                Padding="14,10">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" VerticalAlignment="Center">
                    <Ellipse Fill="{ThemeResource AppAccentBrush}" Width="52" Height="52" Opacity="0.3"
                             services:PulseEffects.EnablePulse="True" />
                    <Ellipse Fill="{ThemeResource AppAccentBrush}" Width="42" Height="42" />
                    <TextBlock x:Name="TxtInitials" Text="D"
                               Foreground="{ThemeResource AppOnAccentBrush}"
                               FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                    <TextBlock x:Name="TxtCallerName" Text="Incoming call"
                               Style="{StaticResource AppBodyStrong}" FontSize="14.5" />
                    <TextBlock Text="Camera stream from a paired device"
                               Style="{StaticResource AppSecondary}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                    <Button Width="42" Height="42" CornerRadius="21"
                            Background="{ThemeResource AppDangerBrush}"
                            Foreground="{ThemeResource AppOnAccentBrush}"
                            BorderThickness="0" Padding="0"
                            Click="BtnDecline_Click"
                            ToolTipService.ToolTip="Decline"
                            AutomationProperties.Name="Decline the call">
                        <FontIcon Glyph="&#xE711;" FontSize="15" />
                    </Button>
                    <Button Width="42" Height="42" CornerRadius="21"
                            Background="{ThemeResource AppSuccessBrush}"
                            Foreground="{ThemeResource AppOnAccentBrush}"
                            BorderThickness="0" Padding="0"
                            Click="BtnAccept_Click"
                            ToolTipService.ToolTip="Accept"
                            AutomationProperties.Name="Accept the call">
                        <FontIcon Glyph="&#xE717;" FontSize="17" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
