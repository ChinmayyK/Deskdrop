<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Deskdrop.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Deskdrop.WinUI"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Global Converters -->
            <local:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
            <local:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibilityConverter"/>
            <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
            <local:MultiplyConverter x:Key="MultiplyConverter"/>
            <local:BoolToFolderIconConverter x:Key="BoolToFolderIconConverter"/>
            <local:BoolToItemCountDotConverter x:Key="BoolToItemCountDotConverter"/>
            <local:ItemCountTextConverter x:Key="ItemCountTextConverter"/>
            <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
            <local:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
            <local:InverseCountToVisibilityConverter x:Key="InverseCountToVisibilityConverter"/>
            <local:PlatformToGlyphConverter x:Key="PlatformToGlyphConverter"/>
            <local:BatteryGlyphConverter x:Key="BatteryGlyphConverter"/>
            <local:NetworkTypeToGlyphConverter x:Key="NetworkTypeToGlyphConverter"/>
            <local:FileTypeToGlyphConverter x:Key="FileTypeToGlyphConverter"/>
            <local:BoolToVisibleConverter x:Key="BoolToVisibleConverter"/>
            <local:StringToBrushConverter x:Key="StringToBrushConverter"/>

            <!-- Standard Semantic Colors matching macOS Dark Mode -->
            <SolidColorBrush x:Key="AppAccentBrush" Color="#0A84FF" />
            <SolidColorBrush x:Key="AppAccentLightBrush" Color="#5E5CE6" />
            <SolidColorBrush x:Key="AppAccentSubtleBrush" Color="#260A84FF" />
            
            <SolidColorBrush x:Key="AppSuccessBrush" Color="#32D74B" />
            <SolidColorBrush x:Key="AppSuccessSubtleBrush" Color="#2632D74B" />

            <SolidColorBrush x:Key="AppWarningBrush" Color="#FF9F0A" />
            <SolidColorBrush x:Key="AppWarningSubtleBrush" Color="#26FF9F0A" />

            <SolidColorBrush x:Key="AppDangerBrush" Color="#FF453A" />
            <SolidColorBrush x:Key="AppDangerSubtleBrush" Color="#26FF453A" />

            <SolidColorBrush x:Key="AppVioletBrush" Color="#BF5AF2" />
            <SolidColorBrush x:Key="AppVioletSubtleBrush" Color="#26BF5AF2" />

            <SolidColorBrush x:Key="AppCyanBrush" Color="#64D2FF" />
            <SolidColorBrush x:Key="AppCyanSubtleBrush" Color="#2664D2FF" />

            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#1E1E1E" />
            <SolidColorBrush x:Key="AppSurfaceBrush" Color="#2C2C2E" />
            <SolidColorBrush x:Key="AppSurfaceElevatedBrush" Color="#3A3A3C" />
            <SolidColorBrush x:Key="AppBorderSubtleBrush" Color="#1EFFFFFF" />
            <SolidColorBrush x:Key="AppBorderStrongBrush" Color="#33FFFFFF" />

            <SolidColorBrush x:Key="SidebarAcrylicBrush" Color="#282828"/>
            <SolidColorBrush x:Key="ModalAcrylicBrush" Color="#1E1E1E"/>

            <!-- Global Control Styles -->
            <Style TargetType="ListViewItem" x:Key="SpacedListViewItemStyle">
                <Setter Property="Margin" Value="0,3,0,3"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            </Style>

            <Style TargetType="Button" x:Key="PrimaryAccentButtonStyle">
                <Setter Property="Background" Value="{StaticResource AppAccentBrush}"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="14,7"/>
                <Setter Property="BorderThickness" Value="0"/>
            </Style>

            <Style TargetType="Button" x:Key="SecondarySubtleButtonStyle">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="14,7"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            </Style>

            <Style TargetType="Button" x:Key="DestructiveButtonStyle">
                <Setter Property="Background" Value="{StaticResource AppDangerSubtleBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource AppDangerBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="14,7"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="{StaticResource AppDangerSubtleBrush}"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
