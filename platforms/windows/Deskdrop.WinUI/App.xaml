<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Deskdrop.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Deskdrop.WinUI"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <Color x:Key="AppBackgroundColor">#0F172A</Color>
            <Color x:Key="AppSurfaceColor">#1E293B</Color>
            <Color x:Key="AppAccentColor">#22C55E</Color>
            
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
            <SolidColorBrush x:Key="AppSurfaceBrush" Color="{StaticResource AppSurfaceColor}" />
            <SolidColorBrush x:Key="AppAccentBrush" Color="{StaticResource AppAccentColor}" />

            <AcrylicBrush x:Key="SidebarAcrylicBrush"
                          BackgroundSource="HostBackdrop"
                          TintColor="{StaticResource AppBackgroundColor}"
                          TintOpacity="0.75"
                          FallbackColor="{StaticResource AppBackgroundColor}" />
                          
            <AcrylicBrush x:Key="ModalAcrylicBrush"
                          BackgroundSource="HostBackdrop"
                          TintColor="{StaticResource AppSurfaceColor}"
                          TintOpacity="0.85"
                          FallbackColor="{StaticResource AppSurfaceColor}" />

            <Style TargetType="ListViewItem" x:Key="SpacedListViewItemStyle">
                <Setter Property="Margin" Value="0,4,0,4"/>
                <Setter Property="Padding" Value="12,8"/>
                <Setter Property="Background" Value="{StaticResource AppSurfaceBrush}"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="#22FFFFFF"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
