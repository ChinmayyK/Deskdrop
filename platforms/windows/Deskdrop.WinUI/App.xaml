<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Deskdrop.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Deskdrop.WinUI"
    RequestedTheme="Light">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Global Converters -->
            <local:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
            <local:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibilityConverter"/>
            <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
            <local:MultiplyConverter x:Key="MultiplyConverter"/>
            <local:BoolToFolderIconConverter x:Key="BoolToFolderIconConverter"/>
            <local:BoolToItemCountDotConverter x:Key="BoolToItemCountDotConverter"/>
            <local:ItemCountTextConverter x:Key="ItemCountTextConverter"/>
            <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
            <local:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
            <local:InverseCountToVisibilityConverter x:Key="InverseCountToVisibilityConverter"/>
            <local:PlatformToGlyphConverter x:Key="PlatformToGlyphConverter"/>
            <local:BatteryGlyphConverter x:Key="BatteryGlyphConverter"/>
            <local:NetworkTypeToGlyphConverter x:Key="NetworkTypeToGlyphConverter"/>
            <local:FileTypeToGlyphConverter x:Key="FileTypeToGlyphConverter"/>
            <local:BoolToVisibleConverter x:Key="BoolToVisibleConverter"/>
            <local:StringToBrushConverter x:Key="StringToBrushConverter"/>

            <!-- Standard Semantic Colors matching macOS Light Mode -->
            <SolidColorBrush x:Key="AppAccentBrush" Color="#007AFF" />
            <SolidColorBrush x:Key="AppAccentLightBrush" Color="#5856D6" />
            <SolidColorBrush x:Key="AppAccentSubtleBrush" Color="#1A007AFF" />
            
            <SolidColorBrush x:Key="AppSuccessBrush" Color="#34C759" />
            <SolidColorBrush x:Key="AppSuccessSubtleBrush" Color="#1A34C759" />

            <SolidColorBrush x:Key="AppWarningBrush" Color="#FF9500" />
            <SolidColorBrush x:Key="AppWarningSubtleBrush" Color="#1AFF9500" />

            <SolidColorBrush x:Key="AppDangerBrush" Color="#FF3B30" />
            <SolidColorBrush x:Key="AppDangerSubtleBrush" Color="#1AFF3B30" />

            <SolidColorBrush x:Key="AppVioletBrush" Color="#AF52DE" />
            <SolidColorBrush x:Key="AppVioletSubtleBrush" Color="#1AAF52DE" />

            <SolidColorBrush x:Key="AppCyanBrush" Color="#32ADE6" />
            <SolidColorBrush x:Key="AppCyanSubtleBrush" Color="#1A32ADE6" />

            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AppSurfaceBrush" Color="#F2F2F7" />
            <SolidColorBrush x:Key="AppSurfaceElevatedBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AppBorderSubtleBrush" Color="#1A000000" />
            <SolidColorBrush x:Key="AppBorderStrongBrush" Color="#33000000" />

            <SolidColorBrush x:Key="SidebarAcrylicBrush" Color="#F5F5F7"/>
            <SolidColorBrush x:Key="ModalAcrylicBrush" Color="#FFFFFF"/>

            <!-- Global Control Styles -->
            <Style TargetType="ListViewItem" x:Key="SpacedListViewItemStyle">
                <Setter Property="Margin" Value="0,3,0,3"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            </Style>

            <Style TargetType="Button" x:Key="PrimaryAccentButtonStyle">
                <Setter Property="Background" Value="{StaticResource AppAccentBrush}"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="14,7"/>
                <Setter Property="BorderThickness" Value="0"/>
            </Style>

            <Style TargetType="Button" x:Key="SecondarySubtleButtonStyle">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="14,7"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            </Style>

            <Style TargetType="Button" x:Key="DestructiveButtonStyle">
                <Setter Property="Background" Value="{StaticResource AppDangerSubtleBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource AppDangerBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="14,7"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="{StaticResource AppDangerSubtleBrush}"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
