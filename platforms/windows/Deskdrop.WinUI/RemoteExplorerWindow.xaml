<Window
    x:Class="Deskdrop.WinUI.RemoteExplorerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Remote Explorer">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Custom TitleBar -->
        <Border x:Name="AppTitleBar" Height="32" Grid.Row="0" Background="Transparent" />

        <!-- Header Controls -->
        <Border Grid.Row="1" Padding="16,0,16,12" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <Button Style="{ThemeResource TransparentButtonStyle}" Grid.Column="0" Click="BtnBack_Click">
                    <FontIcon Glyph="&#xE72B;" />
                </Button>
                
                <TextBlock Text="iPhone (Documents)" Grid.Column="1" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Margin="12,0,0,0"/>
                
                <ToggleButton x:Name="BtnSelectMode" Content="Select" Grid.Column="2" Style="{ThemeResource AccentButtonStyle}" Background="#0A84FF" Foreground="White" CornerRadius="8" Checked="BtnSelectMode_CheckedChanged" Unchecked="BtnSelectMode_CheckedChanged"/>
            </Grid>
        </Border>

        <!-- File List -->
        <ScrollViewer Grid.Row="1" Margin="0,52,0,0">
            <ListView x:Name="FileListView" ItemsSource="{Binding Files}" SelectionMode="None" DoubleTapped="FileListView_MouseDoubleClick" Padding="16">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" Margin="0,0,0,8" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,12,0" Visibility="{Binding DataContext.IsSelectionMode, ElementName=RootGrid}"/>
                                
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE8B7;" Foreground="#0A84FF" FontSize="20"/>
                                    <TextBlock Text="{Binding display_name}" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                
                                <TextBlock Grid.Column="2" Text="{Binding FormattedDate}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <TextBlock Grid.Column="3" Text="{Binding FormattedSize}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </ScrollViewer>

        <!-- Batch Action Bar -->
        <Border Grid.Row="2" x:Name="BatchActionBar" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Padding="16" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Text="{Binding SelectedCountText}" FontSize="14" FontWeight="Medium" VerticalAlignment="Center"/>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="Download" Background="#0A84FF" Foreground="White" CornerRadius="8" Click="BtnDownloadBatch_Click"/>
                    <Button Content="Delete" Foreground="#FF3B30" Style="{ThemeResource TransparentButtonStyle}" Click="BtnDeleteBatch_Click"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>
