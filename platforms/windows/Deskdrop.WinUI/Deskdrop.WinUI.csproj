<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Deskdrop.WinUI</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <PublishProfile Condition="Exists('Properties\PublishProfiles\win-$(Platform).pubxml')">win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Deskdrop</AssemblyName>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="Assets\LockScreenLogo.scale-200.png"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="Assets\Square150x150Logo.scale-200.png"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="Assets\Square44x44Logo.scale-200.png"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="Assets\Square44x44Logo.targetsize-48_altform-lightunplated.png"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="Assets\StoreLogo.png"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="Assets\AppIcon.ico"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="Assets\TrayIcon.ico"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="Assets\Wide310x150Logo.scale-200.png"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Native Rust DLL. Intentionally has only two sources, both built from
      current source:
        1. A DLL dropped directly next to this project (manual dev override).
        2. The `cargo build` release output for deskdrop-core.
      Do NOT add a fallback onto release/windows/deskdrop_core.dll - that
      directory holds a historical release snapshot, not a build input, and
      silently linking against it ships a stale/mismatched core (see commits
      3aa1fb2 / 18fdadb, which patched the C# IPC protocol to match that
      stale DLL instead of rebuilding it).
    -->
    <None Include="deskdrop_core.dll" Condition="Exists('deskdrop_core.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>deskdrop_core.dll</Link>
    </None>
    <None Include="..\..\..\target\release\deskdrop_core.dll" Condition="!Exists('deskdrop_core.dll') and Exists('..\..\..\target\release\deskdrop_core.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>deskdrop_core.dll</Link>
    </None>
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <!--
    Microsoft.Windows.SDK.BuildTools.WinApp adds first-class support for
    `dotnet run` on packaged WinUI apps: it hooks the .NET CLI Run target to
    register a debug identity via the winapp CLI and launch the app with
    package identity (AUMID).
    Set <EnableWinAppRunSupport>false</EnableWinAppRunSupport> in a
    <PropertyGroup>
     above to opt out.
  -->
  <ItemGroup>
    <!--
      Deskdrop.Tray is a standalone companion exe (own process, own
      System.Drawing.Common v8.x) that renders the system tray icon.
      It must stay out-of-process: WinUI here pins System.Drawing.Common to
      v9.x, and loading tray code in-process against that version is the
      exact .NET 9 assembly crash that motivated splitting it out in the
      first place. ReferenceOutputAssembly=false means this is a build-order
      dependency only - its exe is copied into tray\ by the target below,
      never linked into this assembly.
    -->
    <!--
      SkipGetTargetFrameworkProperties is required alongside
      ReferenceOutputAssembly="false" here: newer SDKs (observed on
      8.0.4xx) run their self-contained-executable compatibility check
      (NETSDK1151) against a referenced project's target-framework
      properties regardless of ReferenceOutputAssembly, so building
      against Deskdrop.Tray (a self-contained exe) fails that check even
      though its assembly is never actually linked in. Skipping target-
      framework property retrieval for this reference avoids the check;
      it's safe here because we only need this as a build-order dependency
      (see CopyTrayApp below), not an assembly reference.
      https://aka.ms/netsdk1151
    -->
    <ProjectReference Include="..\Deskdrop.Tray\Deskdrop.Tray.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2270" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" Version="0.4.0" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.1" />
  </ItemGroup>

  <!--
    Copy the built Deskdrop.Tray companion exe (and its dependencies) into a
    tray\ subfolder of this project's own output, so TrayService.cs's
    EnsureTrayProcessRunning() can find and launch it at
    <baseDir>\tray\Deskdrop.Tray.exe. Runs after both Build and Publish so
    `dotnet run`, `dotnet build`, and `dotnet publish` all produce a working
    tray icon.
  -->
  <Target Name="CopyTrayApp" AfterTargets="Build;Publish">
    <ItemGroup>
      <!-- Deskdrop.Tray now builds self-contained win-x64, so its output lives
           in a win-x64\ RID subfolder; point straight at it so files land
           flat in tray\, where EnsureTrayProcessRunning() looks for them. -->
      <TrayAppFiles Include="..\Deskdrop.Tray\bin\$(Configuration)\net8.0-windows10.0.26100.0\win-x64\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(TrayAppFiles)" DestinationFolder="$(OutDir)tray\%(RecursiveDir)" SkipUnchangedFiles="true" Condition="'@(TrayAppFiles)' != ''" />
    <Copy SourceFiles="@(TrayAppFiles)" DestinationFolder="$(PublishDir)tray\%(RecursiveDir)" SkipUnchangedFiles="true" Condition="'$(PublishDir)' != '' and '@(TrayAppFiles)' != ''" />
  </Target>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>


  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <PublishTrimmed>False</PublishTrimmed>
    <SuppressTrimAnalysis>true</SuppressTrimAnalysis>
    <NoWarn>$(NoWarn);IL2026;IL2037;IL2057</NoWarn>
  </PropertyGroup>

</Project>
