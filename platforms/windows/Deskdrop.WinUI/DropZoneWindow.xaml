<Window
    x:Class="Deskdrop.WinUI.DropZoneWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Drop Zone">

    <Grid Background="Transparent">
        <Border x:Name="AppTitleBar" Height="32" VerticalAlignment="Top" Background="Transparent" />
        
        <Border x:Name="DropGrid" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="16" BorderBrush="#40FFFFFF" BorderThickness="1.5" Background="#80000000" AllowDrop="True" DragEnter="DropGrid_DragEnter" DragLeave="DropGrid_DragLeave" Drop="DropGrid_Drop" Width="300" Height="300">
            
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header Status Bar -->
                <Grid Grid.Row="0" Margin="16,16,16,0">
                    <Border HorizontalAlignment="Left" CornerRadius="12" BorderBrush="#40FFFFFF" BorderThickness="1" Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Fill="#34C759" Width="8" Height="8" VerticalAlignment="Center"/>
                            <TextBlock Text="Devices Ready" Foreground="White" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    
                    <Button HorizontalAlignment="Right" Foreground="White" Style="{ThemeResource TransparentButtonStyle}" Click="CloseButton_Click">
                        <FontIcon Glyph="&#xE711;" FontSize="12"/>
                    </Button>
                </Grid>

                <!-- Drop Area Target -->
                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                    <Border CornerRadius="32" Width="64" Height="64" Background="#1AFFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1.5">
                        <FontIcon Glyph="&#xE8B7;" Foreground="White" FontSize="28"/>
                    </Border>
                    
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="DropTitleText" Text="Drop to Broadcast" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="DropSubText" Text="Wireless transfer to nearby devices" Foreground="#8CFFFFFF" FontSize="12" FontWeight="Medium" HorizontalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
