<Window
    x:Class="Deskdrop.WinUI.DropZoneWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Drop files">

    <!--
        Floating drop target. Stays dark glass in both themes (AppScrim*
        tokens) because it sits over arbitrary desktop content. Layout: a
        status chip and close button on top, then an icon well and two
        lines of copy in the middle. DropGrid's background is swapped by
        code-behind while a drag hovers.
    -->
    <Grid Background="Transparent">
        <Border x:Name="AppTitleBar" Height="32" VerticalAlignment="Top" Background="Transparent" />

        <Border x:Name="DropGrid"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                CornerRadius="{StaticResource RadiusLarge}"
                BorderBrush="{ThemeResource AppScrimBorderBrush}"
                BorderThickness="1"
                Background="{ThemeResource AppScrimStrongBrush}"
                AllowDrop="True"
                DragEnter="DropGrid_DragEnter"
                DragLeave="DropGrid_DragLeave"
                Drop="DropGrid_Drop"
                Width="300" Height="300"
                Padding="16">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Border HorizontalAlignment="Left" VerticalAlignment="Center"
                            CornerRadius="{StaticResource RadiusPill}"
                            Background="{ThemeResource AppScrimSubtleBrush}"
                            Padding="10,4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Fill="{ThemeResource AppSuccessBrush}" Width="6" Height="6" VerticalAlignment="Center" />
                            <TextBlock Text="Ready to receive" Foreground="White"
                                       FontFamily="{StaticResource AppTextFont}"
                                       FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                            Foreground="White"
                            Style="{StaticResource AppIconButtonSmall}"
                            Click="CloseButton_Click"
                            ToolTipService.ToolTip="Close"
                            AutomationProperties.Name="Close the drop target">
                        <FontIcon Glyph="&#xE711;" FontSize="12" />
                    </Button>
                </Grid>

                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                    <Border Width="56" Height="56"
                            HorizontalAlignment="Center"
                            CornerRadius="{StaticResource RadiusMedium}"
                            Background="{ThemeResource AppScrimSubtleBrush}">
                        <FontIcon Glyph="&#xE898;" Foreground="White" FontSize="22"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Spacing="6">
                        <TextBlock x:Name="DropTitleText" Text="Drop files to send"
                                   Foreground="White"
                                   FontFamily="{StaticResource AppDisplayFont}"
                                   FontSize="18" FontWeight="Bold"
                                   HorizontalAlignment="Center" />
                        <TextBlock x:Name="DropSubText"
                                   Text="They go straight to your connected devices."
                                   Foreground="{ThemeResource AppScrimTextSecondaryBrush}"
                                   FontFamily="{StaticResource AppTextFont}"
                                   FontSize="12.5"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap" MaxWidth="220" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
