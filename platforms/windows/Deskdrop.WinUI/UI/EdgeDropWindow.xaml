<Window
    x:Class="Deskdrop.WinUI.UI.EdgeDropWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Edge drop">

    <!--
        The screen-edge drop target. The resting sliver was an accent-to-cyan
        gradient, which introduced a second accent hue into a system that has
        one; it is now a solid accent bar. The copy dropped "portal" and
        "mesh" for words that say what happens.
    -->
    <Grid Background="Transparent" AllowDrop="True"
          DragEnter="Grid_DragEnter" DragLeave="Grid_DragLeave" Drop="Grid_Drop">

        <Border x:Name="AppTitleBar" Height="1" VerticalAlignment="Top" Background="Transparent" />

        <Border x:Name="RestingSliver"
                HorizontalAlignment="Left" VerticalAlignment="Center"
                CornerRadius="3"
                Margin="2,0,0,0"
                Width="6" Height="96"
                Background="{ThemeResource AppAccentBrush}" />

        <Border x:Name="ExpandedCard"
                CornerRadius="{StaticResource RadiusLarge}"
                BorderBrush="{ThemeResource AppAccentBorderBrush}"
                BorderThickness="1"
                Opacity="0" Visibility="Collapsed"
                HorizontalAlignment="Left" VerticalAlignment="Center"
                Margin="16,0,0,0"
                Background="{ThemeResource AppSurfaceElevatedBrush}"
                Padding="22,20">

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <Border Width="44" Height="44"
                        CornerRadius="{StaticResource RadiusCard}"
                        Background="{ThemeResource AppAccentSubtleBrush}"
                        HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE898;" FontSize="19"
                              Foreground="{ThemeResource AppAccentBrush}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Spacing="3">
                    <TextBlock Text="Drop to send"
                               Style="{StaticResource AppBodyStrong}"
                               FontSize="14"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="ExpandedSubText"
                               Text="Release here to send to your connected devices"
                               Style="{StaticResource AppCaption}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="160" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
