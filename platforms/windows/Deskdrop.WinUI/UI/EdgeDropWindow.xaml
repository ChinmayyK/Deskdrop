<Window
    x:Class="Deskdrop.WinUI.UI.EdgeDropWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Edge Drop">

    <Grid Background="Transparent" AllowDrop="True" DragEnter="Grid_DragEnter" DragLeave="Grid_DragLeave">
        <Border x:Name="AppTitleBar" Height="1" VerticalAlignment="Top" Background="Transparent" />
        
        <!-- Resting Edge Sliver -->
        <Border x:Name="RestingSliver" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="2.5" Margin="2,0,0,0" Width="6" Height="100">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#0A84FF" Offset="0.0"/>
                    <GradientStop Color="#5AC8FA" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- Expanded Glass Card -->
        <Border x:Name="ExpandedCard" CornerRadius="16" BorderBrush="#0A84FF" BorderThickness="1.5"
                Opacity="0" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0,0,0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="24">
            
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                <Ellipse Fill="#0A84FF" Width="44" Height="44"/>
                <TextBlock Text="Edge Portal Drop ✨" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock x:Name="ExpandedSubText" Text="Instant transfer to active mesh" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
