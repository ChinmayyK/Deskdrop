<Window
    x:Class="Deskdrop.WinUI.DashboardWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Deskdrop.WinUI"
    xmlns:views="using:Deskdrop.WinUI.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="DeskDrop Dashboard">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom Title Bar Area for dragging -->
        <Grid x:Name="AppTitleBar" Height="38" Background="Transparent" Grid.Row="0" Grid.RowSpan="2" VerticalAlignment="Top" Canvas.ZIndex="100"/>

        <!-- Navigation View mimicking exact 3-panel macOS Sidebar -->
        <NavigationView x:Name="NavView"
                        Grid.Row="0" Grid.RowSpan="2"
                        PaneDisplayMode="Left"
                        IsPaneToggleButtonVisible="False"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        OpenPaneLength="220"
                        SelectionChanged="NavView_SelectionChanged"
                        Background="{StaticResource SidebarAcrylicBrush}">
            
            <NavigationView.PaneHeader>
                <StackPanel Orientation="Horizontal" Spacing="8" Padding="16,14,0,16">
                    <TextBlock Text="⚡" FontSize="20" Foreground="{StaticResource AppAccentBrush}"/>
                    <TextBlock Text="DeskDrop" FontSize="18" FontWeight="Bold" Foreground="White"/>
                </StackPanel>
            </NavigationView.PaneHeader>

            <NavigationView.MenuItems>
                <NavigationViewItemHeader Content="WORKSPACE" Margin="12,0,0,4" Foreground="#8E8E93"/>
                <NavigationViewItem Tag="Devices" Content="Devices" x:Name="NavDevices">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F1;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="Clipboard" Content="Clipboard" x:Name="NavClipboard">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8C8;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="Transfers" Content="Transfers" x:Name="NavTransfers">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE896;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="Settings" Content="Settings" x:Name="NavSettings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemSeparator Margin="0,12,0,4"/>
                <NavigationViewItemHeader Content="DEVICES" Margin="12,0,0,4" Foreground="#8E8E93"/>
                <NavigationViewItem Tag="DevicePeer" Content="OnePlus Nord 4" x:Name="NavPeer">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8EA;" Foreground="#34C759"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <!-- Main center + right inspector area inside clean white surface -->
            <Grid Background="{StaticResource AppBackgroundBrush}" BorderBrush="#33FFFFFF" BorderThickness="1,0,0,0">
                <Frame x:Name="ContentFrame" Background="Transparent" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
