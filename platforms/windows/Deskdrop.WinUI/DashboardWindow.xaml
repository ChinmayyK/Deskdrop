<Window
    x:Class="Deskdrop.WinUI.DashboardWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Deskdrop.WinUI"
    xmlns:views="using:Deskdrop.WinUI.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Deskdrop Dashboard">

    <Grid Background="#E8E8E8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom Title Bar Area for dragging -->
        <Grid x:Name="AppTitleBar" Height="40" Background="Transparent" Grid.Row="0" Grid.RowSpan="2" VerticalAlignment="Top" Canvas.ZIndex="100"/>

        <!-- Navigation View mimicking macOS Sidebar -->
        <NavigationView x:Name="NavView"
                        Grid.Row="0" Grid.RowSpan="2"
                        PaneDisplayMode="Left"
                        IsPaneToggleButtonVisible="False"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="True"
                        OpenPaneLength="240"
                        SelectionChanged="NavView_SelectionChanged"
                        Background="Transparent">
            
            <NavigationView.MenuItems>
                <NavigationViewItem Tag="Activity" Content="Activity" x:Name="NavActivity" Margin="0,32,0,0">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="Devices" Content="Devices" x:Name="NavDevices">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F1;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="Transfers" Content="Transfers" x:Name="NavTransfers">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE896;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <!-- White solid content area with rounded corner -->
            <Grid Background="#FFFFFF"
                  CornerRadius="8,0,0,0"
                  BorderBrush="#D0D0D0"
                  BorderThickness="1,1,0,0">
                <ScrollViewer>
                    <Frame x:Name="ContentFrame" Padding="24" Background="Transparent" />
                </ScrollViewer>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
