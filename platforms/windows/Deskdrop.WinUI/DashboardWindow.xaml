<Window
    x:Class="Deskdrop.WinUI.DashboardWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Deskdrop.WinUI"
    xmlns:views="using:Deskdrop.WinUI.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:tb="using:H.NotifyIcon"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="DeskDrop Dashboard">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- System Tray Notification Icon -->
        <tb:TaskbarIcon
            x:Name="TrayIcon"
            x:FieldModifier="public"
            ToolTipText="Deskdrop"
            IconSource="/Assets/TrayIcon.ico"
            LeftClickCommand="{x:Bind ShowMainWindowCommand}"
            DoubleClickCommand="{x:Bind ShowMainWindowCommand}">
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="Open Deskdrop" Command="{x:Bind ShowMainWindowCommand}"/>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem Text="Quit Deskdrop" Command="{x:Bind ((local:App)local:App.Current).ExitApplicationCommand}"/>
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>

        <!-- Custom Fluent TitleBar Area -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent" VerticalAlignment="Stretch" Padding="14,0,140,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Brand Icon & App Title -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Border Width="24" Height="24" CornerRadius="6" Background="{StaticResource AppAccentBrush}">
                    <TextBlock Text="⚡" FontSize="13" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Deskdrop" FontSize="13.5" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                <Border Background="{StaticResource AppBorderSubtleBrush}" CornerRadius="4" Padding="5,2" Margin="4,0,0,0">
                    <TextBlock Text="WINDOWS" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" CharacterSpacing="50"/>
                </Border>
            </StackPanel>

            <!-- Center Live Status Pill -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                <Border Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppBorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="10,4">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="{x:Bind mgr.HeaderStatusBrushObject, Mode=OneWay}"/>
                        <TextBlock Text="{x:Bind mgr.HeaderStatusText, Mode=OneWay}" FontSize="11.5" FontWeight="Medium" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Quick Action Buttons -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button Background="Transparent" BorderThickness="0" Padding="8,4" CornerRadius="6" ToolTipService.ToolTip="Scan for Nearby Devices" Click="OnTitleBarScanClicked">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <FontIcon Glyph="&#xE72C;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="Scan" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Button>
                <Button Background="{StaticResource AppAccentSubtleBrush}" BorderThickness="1" BorderBrush="{StaticResource AppAccentBrush}" Padding="10,4" CornerRadius="6" ToolTipService.ToolTip="Send Files to Connected Devices" Click="OnTitleBarSendClicked">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <FontIcon Glyph="&#xE898;" FontSize="12" Foreground="{StaticResource AppAccentBrush}"/>
                        <TextBlock Text="Send File" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource AppAccentBrush}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Modern NavigationView Workspace Sidebar -->
        <NavigationView x:Name="NavView"
                        Grid.Row="1"
                        PaneDisplayMode="Left"
                        IsPaneToggleButtonVisible="False"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        OpenPaneLength="210"
                        SelectionChanged="NavView_SelectionChanged"
                        Background="{StaticResource SidebarAcrylicBrush}">
            
            <NavigationView.MenuItems>
                <NavigationViewItemHeader Content="WORKSPACE" Margin="10,6,0,4" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                
                <NavigationViewItem Tag="Devices" Content="Devices" x:Name="NavDevices">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8EA;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                
                <NavigationViewItem Tag="Clipboard" Content="Clipboard Bridge" x:Name="NavClipboard">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8C8;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                
                <NavigationViewItem Tag="Transfers" Content="Transfers &amp; Speed" x:Name="NavTransfers">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE896;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Tag="DevicePeer" Content="Remote Files" x:Name="NavPeer">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Tag="Activity" Content="Activity Feed" x:Name="NavActivity">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEC42;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                
                <NavigationViewItem Tag="Settings" Content="Settings" x:Name="NavSettings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.PaneFooter>
                <Border Margin="10,0,10,12" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppBorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE7F4;" FontSize="15" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="This PC" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            <TextBlock Text="{x:Bind localMachineName, Mode=OneTime}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </NavigationView.PaneFooter>

            <!-- Main center content frame inside clean mica/acrylic surface -->
            <Grid Background="{StaticResource AppBackgroundBrush}" BorderBrush="{StaticResource AppBorderSubtleBrush}" BorderThickness="1,0,0,0">
                <Frame x:Name="ContentFrame" Background="Transparent">
                    <Frame.ContentTransitions>
                        <TransitionCollection>
                            <NavigationThemeTransition />
                        </TransitionCollection>
                    </Frame.ContentTransitions>
                </Frame>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
