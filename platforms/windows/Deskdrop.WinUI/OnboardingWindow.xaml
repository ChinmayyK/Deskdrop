<Window
    x:Class="Deskdrop.WinUI.OnboardingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Welcome to Deskdrop">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <!--
        First run. The decorative gradient blobs behind this card are gone -
        they were the loudest thing on the first screen anyone sees, and they
        said nothing. What's left is the sentence that matters and the single
        action that gets someone connected.
    -->
    <Grid>
        <Border x:Name="AppTitleBar" Height="36" VerticalAlignment="Top" Background="Transparent" />

        <Border x:Name="CardRoot"
                CornerRadius="{StaticResource RadiusLarge}"
                BorderBrush="{ThemeResource AppBorderSubtleBrush}"
                BorderThickness="1"
                Margin="24,36,24,24"
                Background="{ThemeResource AppSurfaceElevatedBrush}"
                Opacity="0">
            <Border.RenderTransform>
                <TranslateTransform x:Name="CardTranslate" Y="12" />
            </Border.RenderTransform>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Progress: a row of steps, the current one widened into a
                     capsule rather than just recoloured. -->
                <StackPanel Grid.Row="0" x:Name="PaginationPanel"
                            Orientation="Horizontal" HorizontalAlignment="Center"
                            Margin="0,32,0,0" Spacing="6">
                    <Ellipse x:Name="Dot0" Fill="{ThemeResource AppAccentBrush}" Width="8" Height="8" />
                    <Ellipse x:Name="Dot1" Fill="{ThemeResource AppBorderStrongBrush}" Width="8" Height="8" />
                    <Ellipse x:Name="Dot2" Fill="{ThemeResource AppBorderStrongBrush}" Width="8" Height="8" />
                    <Ellipse x:Name="Dot3" Fill="{ThemeResource AppBorderStrongBrush}" Width="8" Height="8" />
                </StackPanel>

                <Grid Grid.Row="1" x:Name="Step1View" Visibility="Visible">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Margin="32" Spacing="18" MaxWidth="380">

                        <Border Width="56" Height="56"
                                CornerRadius="{StaticResource RadiusLarge}"
                                Background="{ThemeResource AppAccentSubtleBrush}"
                                HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE8EA;" FontSize="24"
                                      Foreground="{ThemeResource AppAccentBrush}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Spacing="7">
                            <TextBlock Text="Connect your first device"
                                       Style="{StaticResource AppDisplayText}"
                                       FontSize="24"
                                       TextAlignment="Center" />
                            <TextBlock Style="{StaticResource AppSecondary}"
                                       FontSize="13.5"
                                       TextAlignment="Center" TextWrapping="Wrap"
                                       Text="Open Deskdrop on your phone or another computer, then scan the pairing code. Everything stays on your local network." />
                        </StackPanel>

                        <Button Content="Show pairing code"
                                Style="{StaticResource AppPrimaryButton}"
                                Padding="18,9" FontSize="13.5"
                                HorizontalAlignment="Center"
                                Click="BtnShowQRCode_Click" />

                        <StackPanel x:Name="ScanningPanel" Visibility="Visible"
                                    Orientation="Horizontal" Spacing="10"
                                    HorizontalAlignment="Center" Margin="0,4,0,0">
                            <ProgressRing IsActive="True" Width="16" Height="16" VerticalAlignment="Center" />
                            <TextBlock Text="Looking for devices on this network"
                                       Style="{StaticResource AppSecondary}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2" Margin="28,0,28,28">
                    <Button x:Name="BtnFooterLeft" Content="Skip for now"
                            Style="{StaticResource AppGhostButton}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            HorizontalAlignment="Left"
                            Click="BtnFooterLeft_Click" />
                    <Button x:Name="BtnFooterRight" Content="Get started"
                            Style="{StaticResource AppPrimaryButton}"
                            Padding="20,8"
                            HorizontalAlignment="Right"
                            Visibility="Collapsed"
                            Click="BtnFooterRight_Click" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
