<Window
    x:Class="Deskdrop.WinUI.OnboardingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Welcome to Deskdrop">

    <Grid Background="Transparent">
        <Border x:Name="AppTitleBar" Height="32" VerticalAlignment="Top" Background="Transparent" />
        
        <Border CornerRadius="12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Margin="24" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
            <Grid>
                <!-- Background Elements -->
                <Grid>
                    <Ellipse Fill="#E5F2FF" Margin="-100,-100,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0.5" Width="200" Height="200"/>
                    <Ellipse Fill="#E5F9E9" Margin="0,0,-50,-50" HorizontalAlignment="Right" VerticalAlignment="Bottom" Opacity="0.5" Width="150" Height="150"/>
                </Grid>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Pagination -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,40,0,0" x:Name="PaginationPanel" Spacing="8">
                        <Ellipse x:Name="Dot0" Fill="#005FB8" Width="8" Height="8"/>
                        <Ellipse x:Name="Dot1" Fill="#D1D1D6" Width="8" Height="8"/>
                        <Ellipse x:Name="Dot2" Fill="#D1D1D6" Width="8" Height="8"/>
                        <Ellipse x:Name="Dot3" Fill="#D1D1D6" Width="8" Height="8"/>
                    </StackPanel>

                    <!-- Step 1 -->
                    <Grid Grid.Row="1" x:Name="Step1View" Visibility="Visible">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                            <TextBlock Text="Step 1: Find a device" FontSize="28" FontWeight="Bold" TextAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Text="Make sure Deskdrop is running on your phone or another computer." FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" Margin="0,0,0,24"/>
                            <Button Content="Show QR Code" Background="#0A84FF" Foreground="White" Padding="16,8" FontSize="14" HorizontalAlignment="Center" Click="BtnShowQRCode_Click" Margin="0,0,0,24"/>
                            
                            <ScrollViewer VerticalScrollBarVisibility="Hidden">
                                <StackPanel>
                                    <StackPanel x:Name="ScanningPanel" Visibility="Visible" Spacing="12">
                                        <Grid HorizontalAlignment="Center" Margin="0,32,0,12">
                                            <FontIcon Glyph="&#xE8A5;" Foreground="#0A84FF" FontSize="24"/>
                                        </Grid>
                                        <TextBlock Text="Scanning local network..." FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center"/>
                                    </StackPanel>
                                    
                                    <!-- Add items list view when devices are found -->
                                </StackPanel>
                            </ScrollViewer>
                        </StackPanel>
                    </Grid>

                    <!-- Footer Navigation -->
                    <Grid Grid.Row="2" Margin="40,0,40,40">
                        <Button x:Name="BtnFooterLeft" Content="Skip for now" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource TransparentButtonStyle}" HorizontalAlignment="Left" Click="BtnFooterLeft_Click"/>
                        <Button x:Name="BtnFooterRight" Content="Get Started" Background="#0A84FF" Foreground="White" Padding="24,12" HorizontalAlignment="Right" Click="BtnFooterRight_Click" Visibility="Collapsed"/>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
