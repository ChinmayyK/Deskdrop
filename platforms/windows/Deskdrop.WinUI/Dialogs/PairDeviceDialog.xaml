<ContentDialog
    x:Class="Deskdrop.WinUI.PairDeviceDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Deskdrop.WinUI"
    xmlns:services="using:Deskdrop.WinUI.Services"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Pair a new device"
    CloseButtonText="Done"
    DefaultButton="Close">

    <ContentDialog.Resources>
        <!--
            Per-state icon colours for StatusGlyph. Assigned as a Style
            (Foreground bound via ThemeResource) rather than resolved to a
            Brush in code-behind: a code-behind Application.Current.Resources
            lookup ignores this specific window's forced theme and can pick
            up the system theme's variant instead, which is the same class of
            bug fixed in Services/InteractionEffects.cs. Handing the element a
            Style whose Setter uses ThemeResource lets WinUI's own theme
            resolution - which is always correct per-element - do the work.
        -->
        <Style x:Key="StatusGlyphWarningStyle" TargetType="FontIcon">
            <Setter Property="Foreground" Value="{ThemeResource AppWarningBrush}" />
        </Style>
        <Style x:Key="StatusGlyphSuccessStyle" TargetType="FontIcon">
            <Setter Property="Foreground" Value="{ThemeResource AppSuccessBrush}" />
        </Style>
        <Style x:Key="StatusGlyphErrorStyle" TargetType="FontIcon">
            <Setter Property="Foreground" Value="{ThemeResource AppDangerBrush}" />
        </Style>
    </ContentDialog.Resources>

    <!--
        Pairing used to live in a permanent dashboard card that consumed a
        quarter of the Devices screen to hold one button, plus a separate
        top-level window. It is a task with a beginning and an end, so it
        belongs in a focused sheet: the QR is the focal point, and the
        progression (waiting -> request received -> paired) happens in place.
    -->
    <StackPanel Width="332" Spacing="16">

        <TextBlock Style="{StaticResource AppSecondary}"
                   TextWrapping="Wrap"
                   Text="Open Deskdrop on your phone or another computer and scan this code. Nothing leaves your local network." />

        <!-- QR needs a solid white quiet zone to stay scannable regardless
             of the app's own theme. -->
        <Border Background="White"
                CornerRadius="{StaticResource RadiusLarge}"
                Padding="16"
                HorizontalAlignment="Center">
            <Grid Width="196" Height="196">
                <ProgressRing x:Name="QrLoadingRing" IsActive="True" Width="30" Height="30" />
                <Image x:Name="QrCodeImage" Stretch="Uniform" Visibility="Collapsed"
                       AutomationProperties.Name="Pairing QR code" />
                <StackPanel x:Name="QrErrorPanel" Visibility="Collapsed" Spacing="8"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE783;" FontSize="22"
                              Foreground="#C2331F" HorizontalAlignment="Center" />
                    <TextBlock Text="Couldn't reach the local service"
                               FontSize="11.5" FontWeight="SemiBold" Foreground="#5A5A60"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" Width="150" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Live status. Replaces a static marketing sentence with the one
             thing the user is actually waiting on. -->
        <Border x:Name="StatusPanel"
                Background="{ThemeResource AppSurfaceSubtleBrush}"
                CornerRadius="{StaticResource RadiusMedium}"
                Padding="12,10">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Width="16" Height="16" VerticalAlignment="Center">
                    <ProgressRing x:Name="WaitingRing" IsActive="True" Width="16" Height="16" />
                    <!-- Foreground is intentionally NOT set here: a local
                         value would out-rank the per-state Styles the
                         code-behind assigns (Warning/Success/Error), which
                         is how this icon used to end up permanently green
                         regardless of what state it was actually showing. -->
                    <FontIcon x:Name="StatusGlyph" Glyph="&#xE73E;" FontSize="14"
                              Visibility="Collapsed" />
                </Grid>

                <StackPanel Grid.Column="1" Spacing="1">
                    <TextBlock x:Name="StatusTitle" Style="{StaticResource AppBodyStrong}"
                               FontSize="13" Text="Waiting for a device to scan" />
                    <TextBlock x:Name="StatusDetail" Style="{StaticResource AppCaption}"
                               TextWrapping="Wrap"
                               Text="This code stays valid while the window is open." />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Incoming request: the security PIN comparison. Shown only when a
             device has actually asked, so the sheet never displays an empty
             ceremony. -->
        <ItemsControl ItemsSource="{x:Bind mgr.PairingRequests, Mode=OneWay}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:PeerViewModel">
                    <Border Background="{ThemeResource AppWarningSubtleBrush}"
                            BorderBrush="{ThemeResource AppWarningBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusCard}"
                            Padding="14,12"
                            Margin="0,0,0,8">
                        <StackPanel Spacing="10">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}"
                                           Style="{StaticResource AppBodyStrong}" />
                                <TextBlock Style="{StaticResource AppSecondary}"
                                           TextWrapping="Wrap"
                                           Text="Confirm this code matches the one shown on that device." />
                            </StackPanel>

                            <Border Background="{ThemeResource AppSurfaceBrush}"
                                    BorderBrush="{ThemeResource AppBorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusSmall}"
                                    Padding="12,8"
                                    HorizontalAlignment="Left">
                                <TextBlock Text="{x:Bind pairingPin, Mode=OneWay}"
                                           Style="{StaticResource AppMono}"
                                           FontSize="17"
                                           CharacterSpacing="180" />
                            </Border>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Style="{StaticResource AppSuccessButton}"
                                        Content="Codes match - pair"
                                        Click="OnAcceptPairingClicked" />
                                <Button Style="{StaticResource AppDestructiveButton}"
                                        Content="Decline"
                                        Click="OnDeclinePairingClicked" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button x:Name="RetryButton" Style="{StaticResource AppSecondaryButton}"
                Content="Try again"
                HorizontalAlignment="Stretch"
                Visibility="Collapsed"
                Click="OnRetryClicked" />
    </StackPanel>
</ContentDialog>
