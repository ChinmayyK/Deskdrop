<Window x:Class="Deskdrop.Windows.IncomingCallBannerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        >
<Grid Margin="12">
    <Border CornerRadius="38" BorderThickness="1" BorderBrush="#E5E5EA">
        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                
                <!-- Avatar -->
                <Grid Grid.Column="0" VerticalAlignment="Center">
                    <Ellipse x:Name="PulseRing" Fill="#32ADE6" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse Fill="#32ADE6" />
                    <TextBlock x:Name="TxtInitials" Text="D" Foreground="White" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                
                <!-- Caller Info -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock x:Name="TxtCallerName" Text="Incoming Call..." Foreground="#1C1C1E" FontSize="16" FontWeight="Bold"/>
                    <TextBlock Text="Camera stream" Foreground="#8E8E93" FontSize="13" Margin="0,2,0,0"/>
                </StackPanel>
                
                <!-- Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button BorderThickness="0" Margin="0,0,12,0" Click="BtnDecline_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" CornerRadius="22" >
                                    <TextBlock Text="X" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button BorderThickness="0" Click="BtnAccept_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" CornerRadius="22" >
                                    <FontIcon Glyph="&#xE8A5;"    Foreground="White"  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>










