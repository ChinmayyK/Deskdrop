<Window
    x:Class="Deskdrop.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Deskdrop Control Center">

    <Window.SystemBackdrop>
        <MicaBackdrop/>
    </Window.SystemBackdrop>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom TitleBar Area (Invisible, just for dragging) -->
        <Border x:Name="AppTitleBar" Height="32" Grid.Row="0" Background="Transparent" />

        <!-- Main Content -->
        <StackPanel Grid.Row="1" Padding="16,0,16,16" Spacing="12">
            
            <!-- Top Module: Device Info & Dashboard -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8" 
                    Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <Border Background="{StaticResource AppAccentBrush}" Width="48" Height="48" CornerRadius="8" Grid.Column="0">
                        <FontIcon Glyph="&#xE896;" Foreground="White" FontSize="24" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Grid.Column="1" Margin="16,0,0,0">
                        <TextBlock Text="Your Device" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                        <TextBlock Text="Discoverable" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13"/>
                    </StackPanel>
                    
                    <!-- Open Dashboard Button -->
                    <Button Grid.Column="2" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Open Full Dashboard" AutomationProperties.Name="Open Full Dashboard" Click="BtnOpenDashboard_Click">
                        <FontIcon Glyph="&#xE713;" FontSize="18"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Middle Module: Recent Activity -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8" 
                    Padding="0,8,0,8">
                <StackPanel>
                    <TextBlock Text="RECENT ACTIVITY" 
                               FontSize="11" 
                               FontWeight="SemiBold" 
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" 
                               CharacterSpacing="50"
                               Margin="16,8,16,8"/>
                    <ListView ItemsSource="{x:Bind RecentTransfers, Mode=OneWay}" 
                              SelectionMode="None" 
                              Background="Transparent"
                              BorderThickness="0">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <StackPanel Orientation="Horizontal" Padding="4,8" Spacing="12">
                                    <FontIcon Glyph="&#xE7C3;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{x:Bind}" VerticalAlignment="Center" Style="{ThemeResource BodyTextBlockStyle}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <!-- Bottom Module: Actions -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8" 
                    Padding="16">
                <Button Content="Pair New Device" 
                        HorizontalAlignment="Stretch" 
                        Click="PairDevice_Click" 
                        Style="{ThemeResource AccentButtonStyle}"
                        CornerRadius="4"
                        Height="36"
                        FontWeight="Medium"/>
            </Border>
            
        </StackPanel>
    </Grid>
</Window>
